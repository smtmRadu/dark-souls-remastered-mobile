+    /** One outline forearm from the button edge to a fist round the grip; dir 1 = from the left, -1 = right. */
+    private void drawTwoHandArm(Canvas c, float dir, float y, float w, int ink, int dark) {
+        c.save();
+        c.scale(dir, 1);
