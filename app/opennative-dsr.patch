+    /**
+     * Icon in the thumb circle: heavy attack = a sword striking down with two impact lines, parry = a shield with a
+     * deflection spark. Line icons in the rim colour, ember once armed.
+     */
+    private void drawGestureIcon(Canvas c, float x, float y, float s, boolean parry, boolean armed, float a) {
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeJoin(Paint.Join.ROUND);
+        paint.setStrokeWidth(Math.max(1.6f * dp, s * 0.14f));
+        paint.setColor(argb(armed ? EMBER : RIM_PRIMARY, armed ? 1f : a * 1.8f));
+        dodgePath.reset();
+        if (parry) {
+            // shield: flat top, sides curving to a point at the bottom
+            float w = s * 0.62f, top = y - s * 0.75f, bottom = y + s * 0.85f;
+            dodgePath.moveTo(x - w, top);
+            dodgePath.lineTo(x + w, top);
+            dodgePath.quadTo(x + w, y + s * 0.35f, x, bottom);
+            dodgePath.quadTo(x - w, y + s * 0.35f, x - w, top);
+            c.drawPath(dodgePath, paint);
+            // spark off the top right corner: three short rays
+            float sx = x + w * 1.05f, sy = top - s * 0.05f;
+            c.drawLine(sx + s * 0.18f, sy - s * 0.18f, sx + s * 0.45f, sy - s * 0.45f, paint);
+            c.drawLine(sx + s * 0.25f, sy + s * 0.02f, sx + s * 0.55f, sy + s * 0.02f, paint);
+            c.drawLine(sx + s * 0.02f, sy - s * 0.25f, sx + s * 0.02f, sy - s * 0.55f, paint);
+        } else {
+            // sword pointing down: blade, cross-guard, grip
+            float tip = y + s * 0.9f, guard = y - s * 0.35f;
+            c.drawLine(x, guard, x, tip, paint);
+            c.drawLine(x - s * 0.42f, guard, x + s * 0.42f, guard, paint);
+            c.drawLine(x, guard, x, y - s * 0.8f, paint);
+            // impact lines at the tip
+            c.drawLine(x - s * 0.35f, tip - s * 0.05f, x - s * 0.75f, tip - s * 0.3f, paint);
+            c.drawLine(x + s * 0.35f, tip - s * 0.05f, x + s * 0.75f, tip - s * 0.3f, paint);
+        }
+        paint.setStrokeCap(Paint.Cap.BUTT);
+    }
+
+    /** Three chevrons on the line from the Attack button centre to the thumb circle, pointing at the thumb. */
+    private void drawChevronTrail(Canvas c, float fromX, float fromY, float toX, float toY, float thumbR, boolean armed, float a) {
+        float dx = toX - fromX, dy = toY - fromY;
+        float len = (float) Math.hypot(dx, dy) - thumbR * 1.15f;   // stop short of the thumb circle
+        if (len < 6 * dp) return;
+        float size = Math.min(9 * dp, len / 5);
+        c.save();
+        c.translate(fromX, fromY);
+        c.rotate((float) Math.toDegrees(Math.atan2(dy, dx)) + 90);   // local -y = towards the thumb
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeWidth(2.6f * dp);
+        paint.setColor(argb(armed ? EMBER : RIM_PRIMARY, armed ? 1f : a * 1.6f));
+        for (int i = 1; i <= 3; i++) {
+            float y = -len * i / 3.6f;
+            c.drawLine(-size, y + size * 0.55f, 0, y - size * 0.45f, paint);
+            c.drawLine(0, y - size * 0.45f, size, y + size * 0.55f, paint);
+        }
+        paint.setStrokeCap(Paint.Cap.BUTT);
+        c.restore();
+    }
+
+    /** Armed strong attack: an ember ring pulses out of the Attack button until release. */
+    private void drawStrongPulse(Canvas c, float cx, float cy, float r) {
+        float phase = (SystemClock.uptimeMillis() % EMBER_PULSE_MS) / (float) EMBER_PULSE_MS;   // 0..1, repeats
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(argb(EMBER, 0.22f + 0.18f * (float) Math.sin(phase * 2 * Math.PI)));
+        c.drawCircle(cx, cy, r, paint);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(3 * dp * (1 - phase) + 1 * dp);
+        paint.setColor(argb(EMBER, 0.9f * (1 - phase)));
+        c.drawCircle(cx, cy, r + phase * 14 * dp, paint);
+        paint.setStrokeWidth(2 * dp);
+        paint.setColor(argb(EMBER, 0.95f));
+        c.drawCircle(cx, cy, r, paint);
+        view.postInvalidateOnAnimation();
+    }
+
+    private void drawStick(Canvas c, ControlElement el, float a) {
+        float r = el.getBoundingBox().width() * 0.5f;
+        boolean active = !Float.isNaN(stickX);
+        float cx = active ? stickX : el.getX(), cy = active ? stickY : el.getY();
+        android.graphics.Bitmap bg = DsrAssets.INSTANCE.ui("slot_bg");   // skin present: bronze rims, no texture
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(argb(FILL, a));
+        c.drawCircle(cx, cy, r, paint);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth((bg != null ? 2 : 1.4f) * dp);
+        paint.setColor(bg != null ? argb(active ? BRONZE_LIT : BRONZE, Math.min(1f, a * 2f)) : argb(RIM, a * 1.4f));
+        c.drawCircle(cx, cy, r, paint);
+        float kx = active ? knobX : cx, ky = active ? knobY : cy;
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(bg != null ? argb(0x2a2620, Math.min(1f, a * 2f)) : argb(KNOB, a * (active ? 1.2f : 0.8f)));
+        c.drawCircle(kx, ky, r * 0.42f, paint);
+        if (bg != null) {
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(2 * dp);
+            paint.setColor(argb(active ? BRONZE_LIT : BRONZE, Math.min(1f, a * 2.2f)));
+            c.drawCircle(kx, ky, r * 0.42f, paint);
+        }
+    }
+
+    // ---------------- cutscene skip ----------------
+
+    /**
+     * Cutscene (DsrGameState.cutscene): only a round Skip button, top right. Hold it SKIP_HOLD_MS: a bronze ring
+     * fills and the centre counts down (2.0 .. 0.1 s); releasing resets it. Then Start, the game's skip input
+     * (user 2026-10-15: hold 2 s, a visible countdown, reset on release). One Start per cutscene.
+     */
+    private static final long SKIP_HOLD_MS = 2000;
+    private static final float SKIP_R_DP = 38f, SKIP_MARGIN_DP = 28f;
+    private int skipPointer = -1;
+    private long skipDownAt;
+    private boolean skipDone;
+    private final Runnable skipFire = new Runnable() { @Override public void run() { skipNow(); } };
+    private void skipNow() {
+        if (skipPointer < 0 || skipDone) return;
+        skipDone = true;
+        skipPointer = -1;
+        haptic();
+        timber.log.Timber.tag("DSR").i("cutscene skip: Start");
+        pulse(Binding.GAMEPAD_BUTTON_START);
+        view.invalidate();
+    }
+
+    private float skipX() { return view.getWidth() - (SKIP_MARGIN_DP + SKIP_R_DP) * dp; }
+    private float skipY() { return (SKIP_MARGIN_DP + SKIP_R_DP) * dp; }
+
+    private void skipTouch(MotionEvent e) {
+        int am = e.getActionMasked(), i = e.getActionIndex();
+        if (am == MotionEvent.ACTION_DOWN || am == MotionEvent.ACTION_POINTER_DOWN) {
+            float r = SKIP_R_DP * dp * 1.4f;   // generous hit area
+            if (skipPointer < 0 && !skipDone && Math.hypot(e.getX(i) - skipX(), e.getY(i) - skipY()) <= r) {
+                skipPointer = e.getPointerId(i);
+                skipDownAt = SystemClock.uptimeMillis();
+                view.postDelayed(skipFire, SKIP_HOLD_MS);
+                haptic();
+            }
+        } else if (am == MotionEvent.ACTION_UP || am == MotionEvent.ACTION_POINTER_UP || am == MotionEvent.ACTION_CANCEL) {
+            if (am == MotionEvent.ACTION_CANCEL || e.getPointerId(i) == skipPointer) {
+                skipPointer = -1;
+                view.removeCallbacks(skipFire);
+            }
+        }
+        view.invalidate();
+    }
+
+    private void drawSkip(Canvas c) {
+        float cx = skipX(), cy = skipY(), r = SKIP_R_DP * dp, v = visibility;
+        boolean holding = skipPointer >= 0;
+        long held = holding ? Math.min(SKIP_HOLD_MS, SystemClock.uptimeMillis() - skipDownAt) : 0;
+        // body
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(argb(holding ? FILL_PRESSED : FILL, v * 0.6f));
+        c.drawCircle(cx, cy, r, paint);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(2 * dp);
+        paint.setColor(argb(BRONZE, v * 0.9f));
+        c.drawCircle(cx, cy, r, paint);
+        // progress ring
+        if (held > 0) {
+            paint.setStrokeWidth(4 * dp);
+            paint.setStrokeCap(Paint.Cap.ROUND);
+            paint.setColor(argb(BRONZE_LIT, v));
+            rect.set(cx - r + 3 * dp, cy - r + 3 * dp, cx + r - 3 * dp, cy + r - 3 * dp);
+            c.drawArc(rect, -90, 360f * held / SKIP_HOLD_MS, false, paint);
+            paint.setStrokeCap(Paint.Cap.BUTT);
+        }
+        // centre: "Skip" idle, the seconds left while held
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(argb(INK, v * 0.95f));
+        String label;
+        if (skipDone) label = "...";
+        else if (holding) label = String.format(java.util.Locale.US, "%.1f", Math.max(0.1f, (SKIP_HOLD_MS - held) / 1000f));
+        else label = "Skip";
+        paint.setTextSize((holding ? 20 : 17) * dp);
+        c.drawText(label, cx, cy - (paint.descent() + paint.ascent()) / 2, paint);
+        // caption under the button
+        if (!holding && !skipDone) {
+            paint.setTextSize(11 * dp);
+            paint.setColor(argb(INK, v * 0.7f));
+            c.drawText("hold", cx, cy + r + 15 * dp, paint);
+        }
+        if (holding) view.postInvalidateOnAnimation();
+    }
+
+    private static int argb(int rgb, float alpha) {
+        return ((int) (Math.min(1f, alpha) * 255) << 24) | (rgb & 0xffffff);
+    }
+}
