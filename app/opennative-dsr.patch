+        // fist over the grip
+        twoHandPath.reset();
+        twoHandPath.moveTo(-40, y - 3); twoHandPath.quadTo(-34, y - 6, -20, y - 5); twoHandPath.lineTo(8, y - 4);
+        twoHandPath.quadTo(15, y - 3, 15, y + 4); twoHandPath.lineTo(15, y + 12); twoHandPath.quadTo(15, y + 19, 8, y + 19);
+        twoHandPath.lineTo(-20, y + 19); twoHandPath.quadTo(-34, y + 20, -40, y + 19); twoHandPath.close();
+        paint.setStyle(Paint.Style.FILL); paint.setColor(dark); c.drawPath(twoHandPath, paint);
+        paint.setStyle(Paint.Style.STROKE); paint.setColor(ink); paint.setStrokeWidth(w); c.drawPath(twoHandPath, paint);
