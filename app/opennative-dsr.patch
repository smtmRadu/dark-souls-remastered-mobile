+        int active = app.gamenative.dsr.DsrGameState.INSTANCE.getMenuScreen().getTab();
+        if (dsrPendingTab >= 0 && active != dsrPendingTab && android.os.SystemClock.uptimeMillis() - dsrPendingTabAt < 1500) active = dsrPendingTab;
+        else dsrPendingTab = -1;
