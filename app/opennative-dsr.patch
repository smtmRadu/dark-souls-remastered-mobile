+        paint.setStrokeWidth(w);
+        twoHandPath.reset();
+        twoHandPath.moveTo(-17, -95); twoHandPath.lineTo(-17, -20); twoHandPath.lineTo(17, -20); twoHandPath.lineTo(17, -95);
+        c.drawPath(twoHandPath, paint);
+        paint.setStrokeWidth(w * 0.55f);
+        twoHandPath.reset();
+        twoHandPath.moveTo(-4, -95); twoHandPath.lineTo(-4, -34); twoHandPath.quadTo(0, -27, 4, -34); twoHandPath.lineTo(4, -95);
+        c.drawPath(twoHandPath, paint);
+        // crossguard
+        paint.setStyle(Paint.Style.FILL);
+        twoHandPath.reset();
+        twoHandPath.moveTo(-50, -12); twoHandPath.quadTo(-30, -22, 0, -21); twoHandPath.quadTo(30, -22, 50, -12);
+        twoHandPath.lineTo(48, -6); twoHandPath.quadTo(30, -12, 0, -11); twoHandPath.quadTo(-30, -12, -48, -6); twoHandPath.close();
+        c.drawPath(twoHandPath, paint);
+        c.drawCircle(-51, -8, 5, paint);
+        c.drawCircle(51, -8, 5, paint);
+        // grip + wrap lines
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(w * 0.8f);
+        iconRect.set(-7, -10, 7, 48);
+        c.drawRoundRect(iconRect, 3, 3, paint);
+        paint.setStrokeWidth(w * 0.45f);
+        c.drawLine(-7, -2, 7, 4, paint);
+        c.drawLine(-7, 40, 7, 46, paint);
+        // pommel
+        paint.setStyle(Paint.Style.FILL);
+        iconRect.set(-11, 48, 11, 64);
+        c.drawOval(iconRect, paint);
+        paint.setColor(dark);
+        iconRect.set(-4.5f, 53, 4.5f, 59);
+        c.drawOval(iconRect, paint);
+        // arms: left high, right low (mirrored)
+        drawTwoHandArm(c, 1, 6, w, ink, dark);
+        drawTwoHandArm(c, -1, 27, w, ink, dark);
+        c.restore();
+        paint.setStrokeCap(Paint.Cap.BUTT);
+    }
