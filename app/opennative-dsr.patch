+    /**
+     * B = roll with the stick pushed, backstep without (the game's rule). Line icons in the label ink:
+     * roll = a circular arrow (a tumble); backstep = a figure facing right, hopping back to the left: leaning
+     * torso, legs in a stride, guard arm forward, speed lines on the side it left, ground line (user 2026-10-15:
+     * the two chevrons had no meaning).
+     */
+    private void drawDodgeIcon(Canvas c, float cx, float cy, float r, boolean roll, float a) {
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeJoin(Paint.Join.ROUND);
+        paint.setStrokeWidth(Math.max(2 * dp, r * 0.09f));
+        paint.setColor(argb(INK, a * 1.8f));
+        dodgePath.reset();
+        if (roll) {
+            float q = r * 0.42f;
+            iconRect.set(cx - q, cy - q, cx + q, cy + q);
+            dodgePath.addArc(iconRect, -60, 290);   // open circle, gap at the top right
+            c.drawPath(dodgePath, paint);
+            // arrowhead at the arc end (angle -60 + 290 = 230 deg), pointing along the turn (clockwise)
+            double e = Math.toRadians(230);
+            float ex = cx + q * (float) Math.cos(e), ey = cy + q * (float) Math.sin(e);
+            double tan = e + Math.PI / 2;   // clockwise tangent
+            float h = r * 0.2f;
+            dodgePath.reset();
+            dodgePath.moveTo(ex + h * (float) Math.cos(tan + 2.6), ey + h * (float) Math.sin(tan + 2.6));
+            dodgePath.lineTo(ex, ey);
+            dodgePath.lineTo(ex + h * (float) Math.cos(tan - 2.6), ey + h * (float) Math.sin(tan - 2.6));
+            c.drawPath(dodgePath, paint);
+        } else {
+            float k = r;   // all points in units of the button radius, figure centred a bit left of the middle
+            float ox = cx - 0.04f * k;
+            paint.setStrokeWidth(Math.max(2 * dp, r * 0.075f));
+            // torso: shoulders ahead of the hips (weight forward while the feet go back)
+            float shX = ox + 0.05f * k, shY = cy - 0.17f * k, hipX = ox - 0.07f * k, hipY = cy + 0.09f * k;
+            dodgePath.moveTo(shX, shY);
+            dodgePath.lineTo(hipX, hipY);
+            // legs: front foot planted ahead, back leg reaching back and down
+            dodgePath.moveTo(hipX, hipY);
+            dodgePath.lineTo(ox + 0.06f * k, cy + 0.24f * k);
+            dodgePath.lineTo(ox + 0.13f * k, cy + 0.38f * k);
+            dodgePath.moveTo(hipX, hipY);
+            dodgePath.lineTo(ox - 0.20f * k, cy + 0.22f * k);
+            dodgePath.lineTo(ox - 0.30f * k, cy + 0.34f * k);
+            // arms: guard arm forward, other arm swung back for balance
+            dodgePath.moveTo(shX, shY + 0.03f * k);
+            dodgePath.lineTo(ox + 0.20f * k, cy - 0.06f * k);
+            dodgePath.lineTo(ox + 0.27f * k, cy - 0.15f * k);
+            dodgePath.moveTo(shX, shY + 0.03f * k);
+            dodgePath.lineTo(ox - 0.14f * k, cy - 0.04f * k);
+            // ground line under the stride
+            dodgePath.moveTo(ox - 0.42f * k, cy + 0.40f * k);
+            dodgePath.lineTo(ox + 0.30f * k, cy + 0.40f * k);
+            c.drawPath(dodgePath, paint);
+            // head
+            paint.setStyle(Paint.Style.FILL);
+            c.drawCircle(ox + 0.11f * k, cy - 0.30f * k, 0.085f * k, paint);
+            // speed lines on the right: the side the figure just left
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(Math.max(1.5f * dp, r * 0.05f));
+            paint.setColor(argb(INK, a * 1.1f));
+            dodgePath.reset();
+            for (int i = 0; i < 3; i++) {
+                float y = cy - 0.16f * k + i * 0.15f * k, x0 = ox + 0.32f * k + (i == 1 ? 0 : 0.05f * k);
+                dodgePath.moveTo(x0, y);
+                dodgePath.lineTo(x0 + 0.14f * k, y);
+            }
+            c.drawPath(dodgePath, paint);
+        }
+        paint.setStrokeCap(Paint.Cap.BUTT);
+    }
