diff --git a/app/src/main/java/app/gamenative/dsr/DsrAssets.kt b/app/src/main/java/app/gamenative/dsr/DsrAssets.kt
new file mode 100644
index 00000000..78c4bd9e
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrAssets.kt
@@ -0,0 +1,77 @@
+package app.gamenative.dsr
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import java.io.File
+import org.json.JSONObject
+import timber.log.Timber
+
+/**
+ * Game icons and names for the touch slots, extracted from the user's own game copy by
+ * tools/extract_assets.py into <game dir>/dsr_assets/ (items.json + icons/<iconId>.png). Never bundled in the APK.
+ * Missing assets = null; the controls then fall back to text labels.
+ */
+object DsrAssets {
+    const val WEAPON = "weapon"   // weapons and shields (EquipParamWeapon)
+    const val GOODS = "goods"     // quick items (EquipParamGoods)
+    const val MAGIC = "magic"
+
+    private var root: File? = null
+    private var items: JSONObject? = null
+    private var prompts: JSONObject? = null
+    private var loaded = false
+    private val icons = HashMap<Int, Bitmap?>()
+
+    fun init(context: Context) {
+        if (root != null) return
+        root = File(DsrLauncher.gameDir(context), "dsr_assets")
+        DsrGameState.gameDir = DsrLauncher.gameDir(context)
+        Thread({ table() }, "DsrAssets").start()   // parse items.json off the UI thread
+    }
+
+    /** Icon of item [id] in [category], or null. Upgraded weapons (id + level) fall back to the base id. */
+    fun icon(category: String, id: Int): Bitmap? {
+        val row = row(category, id) ?: return null
+        val iconId = row.optInt("icon", -1)
+        if (iconId < 0) return null
+        return icons.getOrPut(iconId) {
+            val f = File(root, "icons/$iconId.png")
+            if (f.isFile) BitmapFactory.decodeFile(f.path) else null
+        }
+    }
+
+    private val ui = HashMap<String, Bitmap?>()
+
+    /** Game HUD skin piece (tools/extract_assets.py UI_PIECES: slot_bg, lineframe, plate, parchment), or null. */
+    fun ui(name: String): Bitmap? = ui.getOrPut(name) {
+        val f = File(root ?: return null, "ui/$name.png")
+        if (f.isFile) BitmapFactory.decodeFile(f.path) else null
+    }
+
+    /** Interaction prompt text ("Pick up item", "Talk", ...) for a MenuMan+0x828 id, or null. */
+    fun prompt(id: Int): String? {
+        table()
+        return prompts?.optString(id.toString())?.takeIf { it.isNotEmpty() }
+    }
+
+    fun name(category: String, id: Int): String? = row(category, id)?.optString("name")?.takeIf { it.isNotEmpty() }
+
+    private fun row(category: String, id: Int): JSONObject? {
+        if (id < 0) return null
+        val cat = table()?.optJSONObject(category) ?: return null
+        return cat.optJSONObject(id.toString()) ?: if (category == WEAPON) cat.optJSONObject((id - id % 100).toString()) else null
+    }
+
+    @Synchronized
+    private fun table(): JSONObject? {
+        if (!loaded) {
+            loaded = true
+            items = runCatching { JSONObject(File(root, "items.json").readText()) }
+                .onFailure { Timber.tag("DsrAssets").i("No extracted assets (%s)", it.message) }
+                .getOrNull()
+            prompts = runCatching { JSONObject(File(root, "prompts.json").readText()) }.getOrNull()
+        }
+        return items
+    }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrGameState.kt b/app/src/main/java/app/gamenative/dsr/DsrGameState.kt
new file mode 100644
index 00000000..6664084a
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrGameState.kt
@@ -0,0 +1,467 @@
+package app.gamenative.dsr
+
+import java.io.File
+import java.io.RandomAccessFile
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import timber.log.Timber
+
+/**
+ * Live Dark Souls Remastered game state, read straight from the game's memory.
+ *
+ * Box64 maps the x86 image 1:1, so DarkSoulsRemastered.exe sits at 0x140000000 like on Windows,
+ * and the app (same uid) can read it through /proc/<pid>/mem. Offsets: re/RE_NOTES.md
+ * (exe 1.03.1 = the build Dark-Souls-1-Overhaul targets).
+ */
+object DsrGameState {
+    enum class Phase { NOT_RUNNING, TITLE, LOADING, MENU, GAMEPLAY }
+
+    private const val IMAGE_BASE = 0x140000000L
+    private const val WORLD_CHR_MAN = IMAGE_BASE + 0x1c77e50
+    private const val MENU_MAN = IMAGE_BASE + 0x1c88d98
+    private const val GAME_DATA_MAN = IMAGE_BASE + 0x1c8a530
+    private const val LOCK_TGT_MAN = IMAGE_BASE + 0x1c7a138
+    private const val RENDER_SIZE = IMAGE_BASE + 0x1b68ec8
+    /** RemoMan* (real-time cutscene player). Byte +0x150 = a cutscene plays (getter 0x1404917b0, used by the
+     *  debug event test EcTestRemoPlaying, vtable 0x141400950). docs/ADDRESSES.md */
+    private const val REMO_MAN = IMAGE_BASE + 0x1c71970
+    private val STATION_IDS = intArrayOf(0x19, 0x1a, 0xb, 0xc, 0xd, 0x40, 0x24, 0xb4)   // 0xb4 covenant (3 = open)
+    /** In-game time stops on loading screens: no IGT tick for this long = still loading. */
+    private const val IGT_STALL_MS = 300L
+    private const val LEAVE_LOADING_MS = 500L
+    private const val POLL_MS = 50L   // menu layer switch latency (was 100: menus felt laggy)
+
+    @Volatile var phase: Phase = Phase.NOT_RUNNING
+        private set
+
+    /**
+     * The game's first general dialog of a run is always the "Game will start in offline mode." notice
+     * (Goldberg = no Steam login; the network "Start Offline" setting does not remove it). The app answers it
+     * with A. General dialog = MenuMan state slot 0x11 (+0x74) = 1. One A 400 ms after it appeared was not
+     * always taken (the box fades in; user 2026-10-15: "still appears"): the app now presses A every 700 ms while
+     * this first dialog is up (startupNoticeUp), at most 8 times.
+     */
+    @Volatile var startupNoticeUp = false
+        private set
+    private var startupNoticeDone = false
+
+    /**
+     * Map-action prompt id ("press to pick up / open / talk ..."), MenuMan+0x828 (e.g. 0x98bdf7 = pick up item);
+     * > 0 while the game offers an interaction (FrpgMenuDlgMapAction 0x1406802b0 shows it when this is > 0 and no
+     * item-get popup is up). 1 while the item-get popup is up.
+     */
+    @Volatile var actionPrompt: Int = -1
+        private set
+    /** NPC conversation running (MenuMan 0x9 == 4): the Interact pill reads "Next", a free tap presses A. */
+    @Volatile var talking = false
+        private set
+    /** Character creation sub-step, MenuMan state 0x1e (statelog 2026-10-16): 2 browsing, 5 name box, 7 typing the name. */
+    @Volatile var charMakeStep = 0
+        private set
+    /** A real-time cutscene (remo) or a Bink movie plays: the touch layer shows only the hold-to-skip button. */
+    @Volatile var cutscene = false
+        private set
+    /** actionPrompt value while talking (no game prompt id is this large). */
+    const val TALK_PROMPT = 0x7fff0001
+
+    /** What the slots show. Ids are param row ids (-1 = empty); counts are inventory quantities / casts left. */
+    /** style = player ChrIns+0xb20: 1 one-handed, 3 right weapon two-handed, 2 left weapon two-handed (2H diff). */
+    data class Loadout(val left: Int, val right: Int, val spell: Int, val spellCasts: Int, val quick: Int, val quickCount: Int, val style: Int) {
+        val twoHanded: Int get() = when (style) { 3 -> right; 2 -> left; else -> -1 }
+    }
+
+    /** Tab = index in the game's tab bar (DRB R00-00 icons), -1 = not a tab screen. */
+    enum class MenuScreen(val tab: Int) { OTHER(-1), BAR(-1), INVENTORY(0), EQUIPMENT(1), STATUS(2), SYSTEM(3), OPTIONS(3), BONFIRE(-1), LEVEL_UP(-1), CHAR_MAKE(-1) }
+    /** Open in-game menu screen (MENU phase), for the app's action buttons. */
+    @Volatile var menuScreen = MenuScreen.OTHER
+
+    /** TITLE phase: a sub-screen (Load Game, options, character creation, yes/no) is open, so Back is useful. */
+    @Volatile var titleSubScreen = false
+    /** Title sub-screen is a page with value rows (Options 0x13, Brightness 0x3b, Sound 0x42, PC 0xb1, Network 0xb2):
+     *  the app adds big ◀ ▶ buttons next to Back. */
+    @Volatile var titleOptionPage = false
+        private set
+
+    @Volatile var loadout: Loadout? = null
+        private set
+
+    /** Game folder (set by DsrAssets.init): agent files dsr_title_dlg.txt / dsr_title.txt live there. */
+    @Volatile var gameDir: File? = null
+    private var titleDlgStamp = 0L
+    private var titleDlg = 0L
+
+    /**
+     * Main-menu list shown (vs the "TOUCH TO START" screen): FrpgMenuDlgTitle bytes +0x254 and +0x255 both 1 (the
+     * Update shows the entries only then; both 0 on the start screen). The agent (mod/dinput8/title.c)
+     * publishes the dialog address in dsr_title_dlg.txt.
+     */
+    fun titleListShown(): Boolean {
+        val f = File(gameDir ?: return false, "dsr_title_dlg.txt")
+        val stamp = f.lastModified()
+        if (stamp != titleDlgStamp) {
+            titleDlgStamp = stamp
+            titleDlg = runCatching { f.readText().trim().toLong(16) }.getOrDefault(0L)
+            Timber.tag("DSR").i("title dialog %x (file %d)", titleDlg, stamp)
+        }
+        if (titleDlg == 0L) return false
+        return runCatching { i32(titleDlg + 0x254) and 0xffff == 0x0101 }.getOrDefault(false)
+    }
+
+    /** The agent moved the title highlight to the picked entry (dsr_title_ack.txt, consumed here): press A now. */
+    fun titleAcked(): Boolean {
+        val f = File(gameDir ?: return false, "dsr_title_ack.txt")
+        return f.exists() && f.delete()
+    }
+
+    /** Ask the agent to highlight main-menu entry [k]; press A after [titleAcked]. */
+    fun pickTitleEntry(k: Int) {
+        val dir = gameDir ?: return
+        File(dir, "dsr_title_ack.txt").delete()
+        runCatching {
+            val tmp = File(dir, "dsr_title.tmp")
+            tmp.writeText("$k\n")
+            tmp.renameTo(File(dir, "dsr_title.txt"))
+        }
+    }
+
+    /** Filled quick-item slots (PGD+0x438, 5 inventory indexes, -1 = empty). */
+    @Volatile var quickSlots: Int = 1
+        private set
+
+    /** One lock-on candidate (LockTgtMan list, docs/LOCKON.md §1.1): lock point address + owner handle key it. */
+    class LockCandidate(val lockPoint: Long, val handle: Int, val x: Float, val y: Float, val z: Float, val flags: Int)
+
+    /** Lock-on snapshot: candidates, camera world matrix (16) + fovY/aspect/near/far, render size, locked state. */
+    class LockScan(val candidates: List<LockCandidate>, val cam: FloatArray, val w: Float, val h: Float, val locked: Boolean)
+
+    @Volatile var lockScan: LockScan? = null
+        private set
+
+    /** Touch controls are drawn and own the touches only in gameplay. */
+    val isGameplay: Boolean get() = phase == Phase.GAMEPLAY
+
+    private var thread: Thread? = null
+    private var mem: RandomAccessFile? = null
+    private var pid = -1
+    private val buf = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN)
+    private var lastIgt = -1
+    private var cutsceneLogged = false
+    private var lastCutsceneAt = 0L
+    private const val CUTSCENE_HOLD_MS = 1500L
+    private var lastIgtTickMs = 0L
+
+    fun start() {
+        if (thread?.isAlive == true) return
+        thread = Thread({
+            while (!Thread.currentThread().isInterrupted) {
+                var raw = runCatching { poll() }.getOrElse { Phase.NOT_RUNNING.also { close() } }
+                // after a cutscene / movie ends (or is skipped) the game passes a short gap (char-make menu, a player
+                // frame) before loading: keep the Skip-only layer CUTSCENE_HOLD_MS so controls do not flash (user 2026-10-16)
+                val nowMs = System.currentTimeMillis()
+                if (cutscene) lastCutsceneAt = nowMs
+                else if (raw != Phase.NOT_RUNNING && raw != Phase.TITLE && nowMs - lastCutsceneAt < CUTSCENE_HOLD_MS) {
+                    cutscene = true; raw = Phase.GAMEPLAY
+                }
+                val next = settle(raw)
+                if (next != phase) Timber.tag("DSR").i("phase %s -> %s", phase, next)
+                phase = next
+                if (next != Phase.LOADING) lastNonLoading = next
+                runCatching { DsrGpuGovernor.tick(next) }
+                try { Thread.sleep(POLL_MS) } catch (e: InterruptedException) { break }
+            }
+            close()
+        }, "DsrGameState").apply { isDaemon = true; start() }
+    }
+
+    fun stop() {
+        thread?.interrupt()
+        thread = null
+        phase = Phase.NOT_RUNNING
+    }
+
+    /**
+     * Leaving LOADING must hold for LEAVE_LOADING_MS: during a loading screen the game shows a player or a ticking
+     * IGT (or a menu state) for one or two polls, and the app flashed the touch controls / Back (user 2026-10-15).
+     * Entering LOADING and every other change stay immediate.
+     */
+    private var pendingPhase: Phase? = null
+    private var lastNonLoading = Phase.NOT_RUNNING
+    private var pendingSince = 0L
+    private fun settle(raw: Phase): Phase {
+        // TITLE -> MENU happens only while a save loads (Continue / Load Game: MENU for ~2 s, Back flashed). The
+        // in-game menu cannot open from the title, so that is LOADING (log 2026-10-15 21:22)
+        if (raw == Phase.MENU && menuScreen != MenuScreen.CHAR_MAKE && (phase == Phase.TITLE || phase == Phase.LOADING && pendingPhase == null && lastNonLoading == Phase.TITLE)) {
+            return Phase.LOADING
+        }
+        if (phase != Phase.LOADING || raw == Phase.LOADING || raw == Phase.NOT_RUNNING) {
+            if (raw == Phase.LOADING && pendingPhase != null)
+                Timber.tag("DSR").i("phase blip during LOADING: %s for %d ms (hidden)", pendingPhase, System.currentTimeMillis() - pendingSince)
+            pendingPhase = null
+            return raw
+        }
+        val now = System.currentTimeMillis()
+        if (raw != pendingPhase) {
+            pendingPhase = raw; pendingSince = now
+        }
+        if (now - pendingSince < LEAVE_LOADING_MS) return Phase.LOADING
+        pendingPhase = null
+        return raw
+    }
+
+    private fun poll(): Phase {
+        cutscene = false
+        if (mem == null && !attach()) return Phase.NOT_RUNNING
+        val menuMan = u64(MENU_MAN)
+        if (menuMan == 0L) return Phase.LOADING
+        if (!startupNoticeDone) {
+            // only on the bare title screen: the agent now removes the notice (title.c patch_offline_notice), so the
+            // first general dialog of a run can be a real question (Quit Game, Load Game delete) that A would confirm
+            val titleBare = i32(menuMan + 0x80) == 1 &&
+                intArrayOf(0x1d, 0x2a, 0x13, 0x3b, 0x42, 0x25, 0x27).none { i32(menuMan + 0x30 + 4 * it) != 0 }
+            val up = titleBare && i32(menuMan + 0x74) == 1
+            if (up && !startupNoticeUp) Timber.tag("DSR").i("startup notice up")
+            if (!up && startupNoticeUp) { startupNoticeDone = true; Timber.tag("DSR").i("startup notice closed") }
+            startupNoticeUp = up
+        }
+        if (i32(menuMan + 0x80) == 1) {
+            // a title sub-screen that needs Back (re/ui/menu_ids.txt): 0x1d Load Game, 0x2a System, 0x13/0x3b/0x42 option pages,
+            // 0x25 face edit, 0x27 class select, 0x11 yes/no box. The plain title list and "Touch to Start" do not.
+            // 0xb1 PC settings / 0xb2 network settings (2 = open; 0 and 5 = closed, user 2026-10-16: no Back, OK dead)
+            titleSubScreen = intArrayOf(0x1d, 0x2a, 0x13, 0x3b, 0x42, 0x25, 0x27, 0x11).any { i32(menuMan + 0x30 + 4 * it) != 0 } ||
+                intArrayOf(0xb1, 0xb2).any { i32(menuMan + 0x30 + 4 * it).let { v -> v != 0 && v != 5 } }
+            titleOptionPage = intArrayOf(0x13, 0xb1, 0xb2).any { i32(menuMan + 0x30 + 4 * it).let { v -> v != 0 && v != 5 } } ||
+                intArrayOf(0x3b, 0x42).any { i32(menuMan + 0x30 + 4 * it) != 0 }
+            return Phase.TITLE
+        }
+        // option pages (0x13 EnvOption, 0x3b DispOption, 0x42 SoundOption) clear state[8] when opened from System
+        // 0xb1 PcOption (PC settings). 0x13 stays 5 after PC settings closes (statelog 2026-10-15): 5 = closed too
+        val s13 = i32(menuMan + 0x30 + 4 * 0x13)
+        val sB1 = i32(menuMan + 0x30 + 4 * 0xb1)
+        val sB2 = i32(menuMan + 0x30 + 4 * 0xb2)   // network settings, same values as 0xb1
+        val optionPage = (s13 != 0 && s13 != 5) || i32(menuMan + 0x30 + 4 * 0x3b) != 0 ||
+            i32(menuMan + 0x30 + 4 * 0x42) != 0 || (sB1 != 0 && sB1 != 5) || (sB2 != 0 && sB2 != 5)
+        // 0x9 = talk-ESD menus (statelog 2026-10-16): 2 = bonfire (Level Up / Kindle ... list) = a menu screen
+        // (gameplay controls hidden, Back shown). 4 = NPC conversation (0x93 = 1 while the subtitle box is up): stays
+        // GAMEPLAY, the player can still walk / fight (user: the stick must stay; as a MENU, taps became mouse clicks
+        // = attacks, swipes became d-pad = weapon swaps, Back = B = backstep). `talking` makes a free tap press A.
+        val s9 = i32(menuMan + 0x30 + 4 * 0x9)
+        talking = s9 == 4
+        val bonfire = s9 != 0 && s9 != 4
+        // 0x17 = Level Up screen (opened from the bonfire list; statelog 2026-10-16: 0x9 2 -> 0, 0x17 0 -> 1 -> 2)
+        val levelUp = i32(menuMan + 0x30 + 4 * 0x17) != 0
+        // station menus (re/ui/menu_ids.txt): 0x19 attune magic, 0x1a bottomless box, 0xb buy shop, 0xc repair,
+        // 0xd upgrade, 0x40 sell shop, 0x24 warp. Attune statelog 2026-10-16: 0x9 2 -> 0, 0x19 0 -> 1 -> 2; before this
+        // it read as GAMEPLAY and showed the gameplay controls (user). Screen OTHER: Back + taps as clicks
+        val station = STATION_IDS.any { i32(menuMan + 0x30 + 4 * it) != 0 }
+        // 0x11 = general dialog (message / yes-no box, FrpgMenuDlgGeneral). At the bonfire: Kindle, Reverse Hollowing,
+        // Covenant without the item / humanity show "... OK" (statelog 2026-10-17: 0x11 0 -> 7 -> 21 -> 0, 0x48 = 1);
+        // the gameplay controls stayed on screen (user). A menu: Back + taps click the box buttons
+        val dialog = i32(menuMan + 0x30 + 4 * 0x11) != 0
+        if (i32(menuMan + 0x50) != 0 || optionPage || bonfire || levelUp || station || dialog) {
+            // MenuMan state[id] = menuMan + 0x30 + 4 * id (re/ui/menu_ids.txt): 2 inventory, 3 equipment
+            // 0x15 status, 0x2a system, state[8] == 8: tab bar open with no tab
+            menuScreen = when {
+                i32(menuMan + 0x30 + 4 * 2) != 0 -> MenuScreen.INVENTORY
+                i32(menuMan + 0x30 + 4 * 3) != 0 -> MenuScreen.EQUIPMENT
+                optionPage -> MenuScreen.OPTIONS
+                levelUp -> MenuScreen.LEVEL_UP
+                bonfire && i32(menuMan + 0x50) == 0 -> MenuScreen.BONFIRE
+                i32(menuMan + 0x30 + 4 * 0x15) != 0 -> MenuScreen.STATUS
+                i32(menuMan + 0x30 + 4 * 0x2a) != 0 -> MenuScreen.SYSTEM
+                i32(menuMan + 0x50) == 8 -> MenuScreen.BAR
+                else -> MenuScreen.OTHER
+            }
+            return Phase.MENU
+        }
+        // Bink movie (opening after character creation): state 0x29 = 1 for the whole movie (with 0x54 = 1, 0x5b = 9;
+        // memory dumps 2026-10-16). Shown like a cutscene: only the Skip button
+        if (i32(menuMan + 0x30 + 4 * 0x29) != 0) {
+            if (!cutsceneLogged) Timber.tag("DSR").i("movie start")
+            cutsceneLogged = true
+            cutscene = true
+            return Phase.GAMEPLAY
+        }
+        charMakeStep = i32(menuMan + 0x30 + 4 * 0x1e)
+        // character creation (New Game; memory dump 2026-10-16): 0x26 main screen, 0x25 face edit, 0x27 class select.
+        // No player exists yet, so without this it read as LOADING and the app showed no buttons
+        // 0x26 is also 1 on the boot logo screens (with 0x3c = 1; user 2026-10-16 saw the buttons on the Bandai Namco
+        // splash): there the sub-step 0x1e is 0, in character creation it is 2 / 5 / 7
+        val s26 = i32(menuMan + 0x30 + 4 * 0x26) != 0 && charMakeStep != 0
+        if (s26 || i32(menuMan + 0x30 + 4 * 0x25) != 0 || i32(menuMan + 0x30 + 4 * 0x27) != 0) {
+            menuScreen = MenuScreen.CHAR_MAKE
+            return Phase.MENU
+        }
+        val worldChrMan = u64(WORLD_CHR_MAN)
+        if (worldChrMan == 0L || u64(worldChrMan + 0x68) == 0L) return Phase.LOADING
+        val gameDataMan = u64(GAME_DATA_MAN)
+        // cutscene: GAMEPLAY with only the Skip button (checked before the IGT stall test, in case IGT stops in remo)
+        val remo = u64(REMO_MAN)
+        if (remo != 0L && bytes(remo + 0x150, 1).get(0).toInt() != 0) {
+            if (!cutsceneLogged) Timber.tag("DSR").i("cutscene start")
+            cutsceneLogged = true
+            cutscene = true
+            actionPrompt = -1
+            return Phase.GAMEPLAY
+        }
+        if (cutsceneLogged) Timber.tag("DSR").i("cutscene end")
+        cutsceneLogged = false
+        val igt = if (gameDataMan == 0L) -1 else i32(gameDataMan + 0xA4)
+        val now = System.currentTimeMillis()
+        if (igt != lastIgt) { lastIgt = igt; lastIgtTickMs = now }
+        if (now - lastIgtTickMs > IGT_STALL_MS) return Phase.LOADING
+        // item-get popup (MenuMan+0x81c = item id, -1 = none) also waits for A: keep the pill up for it
+        actionPrompt = if (i32(menuMan + 0x81c) != -1) 1 else if (talking) TALK_PROMPT else i32(menuMan + 0x828)
+        lockScan = runCatching { readLockScan() }.getOrNull()
+        val pgd = u64(gameDataMan + 0x10)
+        if (pgd != 0L) {
+            quickSlots = (0 until 5).count { i32(pgd + 0x438 + 4L * it) >= 0 }.coerceAtLeast(1)
+            val lo = readLoadout(pgd, u64(worldChrMan + 0x68))
+            if (lo != loadout) Timber.tag("DSR").i("loadout %s", lo)
+            loadout = lo
+        }
+        return Phase.GAMEPLAY
+    }
+
+    /** The game process is the one with DarkSoulsRemastered.exe mapped at the image base. */
+    private fun attach(): Boolean {
+        val procs = File("/proc").listFiles() ?: return false
+        for (p in procs) {
+            val id = p.name.toIntOrNull() ?: continue
+            val cmd = runCatching { File(p, "cmdline").readText() }.getOrNull() ?: continue
+            if (!cmd.contains("DarkSoulsRemastered.exe")) continue
+            val mapped = runCatching {
+                File(p, "maps").useLines { lines -> lines.any { it.startsWith("140000000-") && it.endsWith("DarkSoulsRemastered.exe") } }
+            }.getOrDefault(false)
+            if (mapped) {
+                mem = RandomAccessFile(File(p, "mem"), "r")
+                pid = id
+                startupNoticeDone = false
+                startupNoticeUp = false
+                Timber.tag("DSR").i("Attached to game pid %d", id)
+                return true
+            }
+        }
+        return false
+    }
+
+    /** PlayerGameData layout: re/RE_NOTES.md "Equipment, quick items, spells, inventory". */
+    private fun readLoadout(pgd: Long, chr: Long): Loadout {
+        val l = i32(pgd + 0x30c)
+        val r = i32(pgd + 0x310)
+        val left = if (l in 0..1) i32(pgd + 0x324 + 8L * l) else -1
+        val right = if (r in 0..1) i32(pgd + 0x324 + 8L * r + 4) else -1
+        var spell = -1
+        var casts = 0
+        val magic = u64(pgd + 0x418)
+        if (magic != 0L) {
+            val s = i32(magic + 0x78)
+            if (s in 0..11) { spell = i32(magic + 0x18 + 8L * s); casts = i32(magic + 0x1c + 8L * s) }
+        }
+        var quick = -1
+        var count = 0
+        val inv = u64(pgd + 0x3d8)
+        val q = i32(pgd + 0x44c)
+        if (inv != 0L && q in 0..2047) { quick = i32(inv + 0x1cL * q + 4); count = i32(inv + 0x1cL * q + 8) }
+        return Loadout(left, right, spell, casts, quick, count, if (chr != 0L) i32(chr + 0xb20) else 1)
+    }
+
+    private fun readLockScan(): LockScan? {
+        val lt = u64(LOCK_TGT_MAN)
+        if (lt == 0L) return null
+        val list = ArrayList<LockCandidate>()
+        var e = u64(lt + 0x10)
+        var n = 0
+        while (e != 0L && n++ < 64) {
+            val b = bytes(e, 0x48)
+            val lp = b.getLong(0x38)
+            if (lp != 0L) list.add(LockCandidate(lp, i32(lp + 0x14), b.getFloat(0), b.getFloat(4), b.getFloat(8), b.get(0x40).toInt() and 0xff))
+            e = b.getLong(0x30)
+        }
+        val camPtr = u64(lt + 0x1438)
+        if (camPtr == 0L) return null
+        val c = bytes(camPtr + 0x10, 0x50)
+        val cam = FloatArray(20) { c.getFloat(it * 4) }
+        val rs = u64(RENDER_SIZE)
+        if (rs == 0L) return null
+        val r = bytes(rs + 0x6f0, 8)
+        return LockScan(list, cam, r.getFloat(0), r.getFloat(4), bytes(lt + 0x1430, 1).get(0).toInt() != 0)
+    }
+
+    private fun bytes(addr: Long, n: Int): ByteBuffer {
+        val a = ByteArray(n)
+        val m = mem ?: return ByteBuffer.wrap(a).order(ByteOrder.LITTLE_ENDIAN)
+        m.seek(addr); m.readFully(a)
+        return ByteBuffer.wrap(a).order(ByteOrder.LITTLE_ENDIAN)
+    }
+
+    /**
+     * Candidate nearest to the render-pixel point (gx, gy) within [tol] render px, projected with the game's
+     * camera (docs/LOCKON.md §2: view = inverse(world matrix), D3D LH perspective). Only entries the game can
+     * lock now ((flags & 0x50) == 0x10) or the current target (0x20 while locked).
+     */
+    fun pickLockTarget(gx: Float, gy: Float, tol: Float): LockCandidate? {
+        val s = lockScan ?: return null
+        val view = invert4(s.cam) ?: return null
+        val fovY = s.cam[16]; val aspect = s.cam[17]; val near = s.cam[18]
+        val f = (1.0 / Math.tan(fovY / 2.0)).toFloat()
+        var best: LockCandidate? = null
+        var bestD = tol * tol
+        for (c in s.candidates) {
+            val current = s.locked && (c.flags and 0x20) != 0
+            if ((c.flags and 0x50) != 0x10 && !current) continue
+            // row vector [x y z 1] · view
+            val vx = c.x * view[0] + c.y * view[4] + c.z * view[8] + view[12]
+            val vy = c.x * view[1] + c.y * view[5] + c.z * view[9] + view[13]
+            val vz = c.x * view[2] + c.y * view[6] + c.z * view[10] + view[14]
+            if (vz <= near) continue
+            val px = (vx * (f / aspect) / vz * 0.5f + 0.5f) * s.w
+            val py = (-(vy * f / vz) * 0.5f + 0.5f) * s.h
+            val d = (px - gx) * (px - gx) + (py - gy) * (py - gy)
+            if (d < bestD) { bestD = d; best = c }
+        }
+        return best
+    }
+
+    /** General 4x4 inverse (row-major), null if singular. */
+    private fun invert4(m: FloatArray): FloatArray? {
+        val a = DoubleArray(16) { m[it].toDouble() }
+        val inv = DoubleArray(16)
+        inv[0] = a[5]*a[10]*a[15]-a[5]*a[11]*a[14]-a[9]*a[6]*a[15]+a[9]*a[7]*a[14]+a[13]*a[6]*a[11]-a[13]*a[7]*a[10]
+        inv[4] = -a[4]*a[10]*a[15]+a[4]*a[11]*a[14]+a[8]*a[6]*a[15]-a[8]*a[7]*a[14]-a[12]*a[6]*a[11]+a[12]*a[7]*a[10]
+        inv[8] = a[4]*a[9]*a[15]-a[4]*a[11]*a[13]-a[8]*a[5]*a[15]+a[8]*a[7]*a[13]+a[12]*a[5]*a[11]-a[12]*a[7]*a[9]
+        inv[12] = -a[4]*a[9]*a[14]+a[4]*a[10]*a[13]+a[8]*a[5]*a[14]-a[8]*a[6]*a[13]-a[12]*a[5]*a[10]+a[12]*a[6]*a[9]
+        inv[1] = -a[1]*a[10]*a[15]+a[1]*a[11]*a[14]+a[9]*a[2]*a[15]-a[9]*a[3]*a[14]-a[13]*a[2]*a[11]+a[13]*a[3]*a[10]
+        inv[5] = a[0]*a[10]*a[15]-a[0]*a[11]*a[14]-a[8]*a[2]*a[15]+a[8]*a[3]*a[14]+a[12]*a[2]*a[11]-a[12]*a[3]*a[10]
+        inv[9] = -a[0]*a[9]*a[15]+a[0]*a[11]*a[13]+a[8]*a[1]*a[15]-a[8]*a[3]*a[13]-a[12]*a[1]*a[11]+a[12]*a[3]*a[9]
+        inv[13] = a[0]*a[9]*a[14]-a[0]*a[10]*a[13]-a[8]*a[1]*a[14]+a[8]*a[2]*a[13]+a[12]*a[1]*a[10]-a[12]*a[2]*a[9]
+        inv[2] = a[1]*a[6]*a[15]-a[1]*a[7]*a[14]-a[5]*a[2]*a[15]+a[5]*a[3]*a[14]+a[13]*a[2]*a[7]-a[13]*a[3]*a[6]
+        inv[6] = -a[0]*a[6]*a[15]+a[0]*a[7]*a[14]+a[4]*a[2]*a[15]-a[4]*a[3]*a[14]-a[12]*a[2]*a[7]+a[12]*a[3]*a[6]
+        inv[10] = a[0]*a[5]*a[15]-a[0]*a[7]*a[13]-a[4]*a[1]*a[15]+a[4]*a[3]*a[13]+a[12]*a[1]*a[7]-a[12]*a[3]*a[5]
+        inv[14] = -a[0]*a[5]*a[14]+a[0]*a[6]*a[13]+a[4]*a[1]*a[14]-a[4]*a[2]*a[13]-a[12]*a[1]*a[6]+a[12]*a[2]*a[5]
+        inv[3] = -a[1]*a[6]*a[11]+a[1]*a[7]*a[10]+a[5]*a[2]*a[11]-a[5]*a[3]*a[10]-a[9]*a[2]*a[7]+a[9]*a[3]*a[6]
+        inv[7] = a[0]*a[6]*a[11]-a[0]*a[7]*a[10]-a[4]*a[2]*a[11]+a[4]*a[3]*a[10]+a[8]*a[2]*a[7]-a[8]*a[3]*a[6]
+        inv[11] = -a[0]*a[5]*a[11]+a[0]*a[7]*a[9]+a[4]*a[1]*a[11]-a[4]*a[3]*a[9]-a[8]*a[1]*a[7]+a[8]*a[3]*a[5]
+        inv[15] = a[0]*a[5]*a[10]-a[0]*a[6]*a[9]-a[4]*a[1]*a[10]+a[4]*a[2]*a[9]+a[8]*a[1]*a[6]-a[8]*a[2]*a[5]
+        val det = a[0]*inv[0]+a[1]*inv[4]+a[2]*inv[8]+a[3]*inv[12]
+        if (Math.abs(det) < 1e-12) return null
+        return FloatArray(16) { (inv[it] / det).toFloat() }
+    }
+
+    private fun close() {
+        runCatching { mem?.close() }
+        mem = null
+        pid = -1
+    }
+
+    private fun u64(addr: Long): Long {
+        val m = mem ?: return 0
+        m.seek(addr); m.readFully(buf.array(), 0, 8)
+        return buf.getLong(0)
+    }
+
+    private fun i32(addr: Long): Int {
+        val m = mem ?: return 0
+        m.seek(addr); m.readFully(buf.array(), 0, 4)
+        return buf.getInt(0)
+    }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrGpuGovernor.kt b/app/src/main/java/app/gamenative/dsr/DsrGpuGovernor.kt
new file mode 100644
index 00000000..132a0f07
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrGpuGovernor.kt
@@ -0,0 +1,62 @@
+package app.gamenative.dsr
+
+import android.content.Context
+import app.gamenative.powercontrol.metrics.GpuUsageSampler
+import timber.log.Timber
+
+/**
+ * GPU load limit (user, 2026-10-15: "limit the gpu usage of phone to go like at 50%"). Android has no GPU usage cap
+ * without root, so the render size is the lever: the game state thread samples GPU busy % during GAMEPLAY; at the
+ * next start fitScreen picks a smaller render budget when the last session averaged over TARGET, a larger one when
+ * it stayed well under. The resolution needs a game restart, hence the per-session step.
+ */
+object DsrGpuGovernor {
+    private const val PREFS = "dsr_gpu"
+    private const val TARGET = 50.0          // % GPU busy in gameplay
+    private const val LOW = 35.0             // below this: room for a sharper picture
+    private const val STEP = 0.1
+    // 1.0 gave 1408x576 on the Flip6 and the game crashed at boot (height < 600 is not a valid mode): 1.1 = 648 high
+    const val MIN_BUDGET = 1.1
+    const val MAX_BUDGET = 1.5
+    private const val MIN_SAMPLES = 30       // 1 min of gameplay at SAMPLE_MS
+    private const val SAMPLE_MS = 2000L
+
+    private val sampler = GpuUsageSampler()
+    private var context: Context? = null
+    private var sum = 0.0
+    private var count = 0
+    private var lastSampleMs = 0L
+
+    /** Render budget for this start (multiple of 1280x720 pixels), adjusted from the last session's average. */
+    fun budget(context: Context, default: Double): Double {
+        this.context = context.applicationContext
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        var budget = prefs.getFloat("budget", default.toFloat()).toDouble().coerceIn(MIN_BUDGET, MAX_BUDGET)
+        val avg = prefs.getFloat("avg", -1f).toDouble()
+        if (avg >= 0) {
+            val next = when {
+                avg > TARGET -> budget - STEP
+                avg < LOW -> budget + STEP
+                else -> budget
+            }.coerceIn(MIN_BUDGET, MAX_BUDGET)
+            Timber.tag("DSR").i("gpu governor: last session %.0f %% -> budget %.2f -> %.2f", avg, budget, next)
+            budget = next
+        }
+        prefs.edit().putFloat("budget", budget.toFloat()).remove("avg").apply()
+        sum = 0.0; count = 0
+        return budget
+    }
+
+    /** Game state thread, every poll: one GPU sample per SAMPLE_MS while in gameplay; saves the running average. */
+    fun tick(phase: DsrGameState.Phase) {
+        if (phase != DsrGameState.Phase.GAMEPLAY) return
+        val now = System.currentTimeMillis()
+        if (now - lastSampleMs < SAMPLE_MS) return
+        lastSampleMs = now
+        val pct = sampler.sample()?.percent ?: return
+        sum += pct; count++
+        if (count >= MIN_SAMPLES && count % 15 == 0) {
+            context?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()?.putFloat("avg", (sum / count).toFloat())?.apply()
+        }
+    }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrInstallActivity.kt b/app/src/main/java/app/gamenative/dsr/DsrInstallActivity.kt
