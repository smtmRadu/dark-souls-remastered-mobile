+package app.gamenative.dsr
+
+import android.app.Activity
+import android.content.Intent
+import android.graphics.Color
+import android.graphics.Typeface
+import android.net.Uri
+import android.os.Bundle
+import android.provider.OpenableColumns
+import android.view.Gravity
+import android.view.ViewGroup.LayoutParams.MATCH_PARENT
+import android.view.ViewGroup.LayoutParams.WRAP_CONTENT
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import app.gamenative.MainActivity
+import java.io.FileInputStream
+import kotlin.concurrent.thread
+import timber.log.Timber
+
+/**
+ * First-run screen of a converter build: unpacks the game payload (DsrInstaller), then starts MainActivity.
+ * Fat APK: the payload is inside the APK and the install starts at once. Otherwise the player picks the
+ * DarkSoulsRemastered.dsrdata file the converter wrote next to the APK (system file picker, no storage permission).
+ */
+class DsrInstallActivity : Activity() {
+    private lateinit var status: TextView
+    private lateinit var bar: ProgressBar
+    private lateinit var pick: Button
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val dp = resources.displayMetrics.density
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER
+            setBackgroundColor(Color.BLACK)
+            setPadding((48 * dp).toInt(), 0, (48 * dp).toInt(), 0)
+        }
+        root.addView(TextView(this).apply {
+            text = "DARK SOULS"
+            setTextColor(0xFFEBE5D8.toInt())
+            textSize = 34f
+            typeface = Typeface.SERIF
+            gravity = Gravity.CENTER
+        })
+        status = TextView(this).apply {
+            setTextColor(0xFFB8AE9C.toInt())
+            textSize = 16f
+            gravity = Gravity.CENTER
+            setPadding(0, (24 * dp).toInt(), 0, (16 * dp).toInt())
+        }
+        root.addView(status, LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT))
+        bar = ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal).apply { max = 1000 }
+        root.addView(bar, LinearLayout.LayoutParams(MATCH_PARENT, (12 * dp).toInt()))
+        pick = Button(this).apply {
+            text = "Choose DarkSoulsRemastered.dsrdata"
+            textSize = 18f
+            setOnClickListener {
+                startActivityForResult(Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+                    addCategory(Intent.CATEGORY_OPENABLE); type = "*/*"
+                }, PICK)
+            }
+        }
+        root.addView(pick, LinearLayout.LayoutParams(WRAP_CONTENT, (64 * dp).toInt()).apply { topMargin = (32 * dp).toInt() })
+        setContentView(root)
+
+        if (DsrInstaller.apkHasPayload(this)) {
+            pick.visibility = android.view.View.GONE
+            val apk = java.io.File(applicationInfo.sourceDir)
+            run("Installing the game (one time)…") {
+                DsrInstaller.install(this, FileInputStream(apk), DsrInstaller.APK_PREFIX, apk.length(), it)
+            }
+        } else {
+            status.text = "One-time setup: copy DarkSoulsRemastered.dsrdata (made by the converter, next to the APK) " +
+                "to this phone, then choose it."
+        }
+    }
+
+    @Deprecated("platform API")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        val uri = data?.data ?: return
+        if (requestCode != PICK || resultCode != RESULT_OK) return
+        pick.visibility = android.view.View.GONE
+        val size = sizeOf(uri)
+        run("Installing the game (one time)…") { progress ->
+            contentResolver.openInputStream(uri)!!.use { DsrInstaller.install(this, it, "", size, progress) }
+        }
+    }
+
+    private fun run(title: String, job: ((Float, String) -> Unit) -> Unit) {
+        status.text = title
+        thread(name = "dsr-install") {
+            var last = -1
+            try {
+                job { f, name ->
+                    val p = (f * 1000).toInt()
+                    if (p != last) {
+                        last = p
+                        runOnUiThread { bar.progress = p; status.text = "$title  ${p / 10}%\n$name" }
+                    }
+                }
+                runOnUiThread {
+                    startActivity(Intent(this, MainActivity::class.java))
+                    finish()
+                }
+            } catch (e: Exception) {
+                Timber.e(e, "payload install failed")
+                runOnUiThread {
+                    status.text = "Install failed: ${e.message}\nFree space needed: about 8 GB. Try again."
+                    pick.visibility = android.view.View.VISIBLE
+                }
+            }
+        }
+    }
+
+    private fun sizeOf(uri: Uri): Long = contentResolver.query(uri, arrayOf(OpenableColumns.SIZE), null, null, null)?.use {
+        if (it.moveToFirst()) it.getLong(0) else -1L
+    } ?: -1L
+
+    companion object { private const val PICK = 7 }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrInstaller.kt b/app/src/main/java/app/gamenative/dsr/DsrInstaller.kt
new file mode 100644
index 00000000..8e5e3913
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrInstaller.kt
@@ -0,0 +1,72 @@
+package app.gamenative.dsr
+
+import android.content.Context
+import java.io.File
+import java.io.InputStream
+import java.util.zip.ZipInputStream
+import timber.log.Timber
+
+/**
+ * First-run install of the converter payload (converter/, docs/CONVERTER.md). The payload is a ZIP tree:
+ *   game/...   -> the game folder (DsrLauncher.gameDir): game files, patched menus, dsr_assets
+ *   files/...  -> the app's filesDir: imagefs_bionic.txz, proton-9.0-x86_64.txz, experimental-drm-*.tzst,
+ *                 contents/adrenotools/<driver>/ (what the app would otherwise download on first launch)
+ * Source: the APK itself (entries under assets/payload/, a "fat" build) or a data file the user picks
+ * (DarkSoulsRemastered.dsrdata, entries at the root). Both are read as one forward stream (ZipInputStream, ZIP64 ok).
+ */
+object DsrInstaller {
+    const val APK_PREFIX = "assets/payload/"
+    /** Fixed custom-game id for the converter build (CustomGameScanner reads .gamenative before hashing the path). */
+    private const val APP_ID = 570940
+    private const val MARKER = ".dsr_installed"
+
+    fun needsInstall(context: Context): Boolean {
+        val dir = DsrLauncher.gameDir(context)
+        // a dev phone set up by hand has the exe but no marker: leave it alone
+        return !File(dir, MARKER).isFile && !File(dir, "DarkSoulsRemastered.exe").isFile
+    }
+
+    /** True when this APK carries the payload (fat build). */
+    fun apkHasPayload(context: Context): Boolean = try {
+        java.util.zip.ZipFile(context.applicationInfo.sourceDir).use { it.getEntry(APK_PREFIX + "game/DarkSoulsRemastered.exe") != null }
+    } catch (e: Exception) { Timber.w(e, "payload check"); false }
+
+    /**
+     * Unpacks [input] (a ZIP stream). Only entries under [prefix] are used, the prefix is cut off.
+     * [totalBytes] = payload size for the progress callback (fraction 0..1, current file name).
+     */
+    fun install(context: Context, input: InputStream, prefix: String, totalBytes: Long, progress: (Float, String) -> Unit) {
+        val game = DsrLauncher.gameDir(context)
+        val files = context.filesDir
+        var done = 0L
+        val buf = ByteArray(1 shl 20)
+        ZipInputStream(input.buffered(1 shl 20)).use { zip ->
+            while (true) {
+                val e = zip.nextEntry ?: break
+                if (e.isDirectory || !e.name.startsWith(prefix)) continue
+                val rel = e.name.substring(prefix.length)
+                val dest = when {
+                    rel.startsWith("game/") -> File(game, rel.removePrefix("game/"))
+                    rel.startsWith("files/") -> File(files, rel.removePrefix("files/"))
+                    else -> continue
+                }
+                if (!dest.canonicalPath.startsWith(game.canonicalPath) && !dest.canonicalPath.startsWith(files.canonicalPath)) continue
+                dest.parentFile?.mkdirs()
+                val tmp = File(dest.path + ".part")
+                tmp.outputStream().use { out ->
+                    while (true) {
+                        val n = zip.read(buf)
+                        if (n < 0) break
+                        out.write(buf, 0, n)
+                        done += n
+                        progress(if (totalBytes > 0) (done.toFloat() / totalBytes).coerceAtMost(1f) else 0f, rel)
+                    }
+                }
+                if (!tmp.renameTo(dest)) { dest.delete(); tmp.renameTo(dest) }
+            }
+        }
+        File(game, ".gamenative").writeText("{\"appId\":$APP_ID}")
+        File(game, MARKER).writeText("payload bytes=$done\n")
+        Timber.tag("DSR").i("payload installed: %d bytes", done)
+    }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrLauncher.kt b/app/src/main/java/app/gamenative/dsr/DsrLauncher.kt
new file mode 100644
index 00000000..1cb089d8
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrLauncher.kt
@@ -0,0 +1,195 @@
+package app.gamenative.dsr
+
+import android.app.Activity
+import android.content.Context
+import app.gamenative.data.GameSource
+import app.gamenative.utils.IntentLaunchManager
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.security.MessageDigest
+import javax.crypto.Cipher
+import javax.crypto.spec.IvParameterSpec
+import javax.crypto.spec.SecretKeySpec
+import kotlin.math.roundToInt
+import org.json.JSONObject
+import timber.log.Timber
+
+/**
+ * Single-game mode: every normal app start launches Dark Souls Remastered directly.
+ * The game lives in app-internal storage (never /storage/emulated/0: FUSE crashes under Wine).
+ */
+object DsrLauncher {
+    const val GAME_DIR = "DarkSoulsRemastered"
+
+    /**
+     * CPU list for the game: every core except the slowest cluster (A520 0..1 on the Flip6) and a lone fastest core
+     * (the X4 prime 7: heat). Flip6 -> "2,3,4,5,6", the hand-tuned dev setup. Null if the frequencies are unreadable.
+     */
+    fun gameCpuList(): String? = runCatching {
+        val freq = (0 until Runtime.getRuntime().availableProcessors()).associateWith {
+            File("/sys/devices/system/cpu/cpu$it/cpufreq/cpuinfo_max_freq").readText().trim().toLong()
+        }
+        val min = freq.values.min(); val max = freq.values.max()
+        val cores = freq.filter { (_, f) -> f != min && !(f == max && freq.values.count { it == max } == 1) }.keys.sorted()
+        cores.takeIf { it.size >= 2 }?.joinToString(",")
+    }.getOrNull()
+
+    fun gameDir(context: Context): File = File(context.dataDir, "CustomGames/$GAME_DIR")
+
+    /**
+     * The game is capped at 60 FPS (agent: game pacer FrpgFlipper_60FPS, 2026-10-17); a 120 Hz panel just burns
+     * power and heat (the Flip6 throttles hard at ~45 °C skin). Ask for the lowest mode >= 60 Hz at this resolution.
+     */
+    fun preferLowRefreshRate(activity: Activity) {
+        val display = activity.windowManager.defaultDisplay ?: return
+        val cur = display.mode
+        val mode = display.supportedModes
+            .filter { it.physicalWidth == cur.physicalWidth && it.physicalHeight == cur.physicalHeight && it.refreshRate >= 59f }
+            .minByOrNull { it.refreshRate } ?: return
+        activity.window.attributes = activity.window.attributes.apply {
+            preferredDisplayModeId = mode.modeId
+            preferredRefreshRate = mode.refreshRate
+        }
+        Timber.tag("DsrLauncher").i("Display mode %d @ %.0f Hz", mode.modeId, mode.refreshRate)
+    }
+
+    /**
+     * The in-game agent (mod/dinput8): a dinput8.dll proxy the game loads (WINEDLLOVERRIDES=dinput8=n,b).
+     * The app can read but not write game memory (SELinux), so game patches live there: logic tick governor
+     * (game time = real time at any FPS), 60 FPS cap, touch HUD, menus. Copied on every start so APK updates reach it.
+     */
+    fun installAgent(context: Context) {
+        val dir = gameDir(context)
+        if (!dir.isDirectory) return
+        runCatching {
+            // Dev override: a dinput8.dll.dev pushed into the game folder wins over the bundled agent.
+            val dev = File(dir, "dinput8.dll.dev")
+            val bytes = if (dev.isFile) dev.readBytes() else context.assets.open("dsr/dinput8.dll").use { it.readBytes() }
+            val dst = File(dir, "dinput8.dll")
+            if (!dst.exists() || !dst.readBytes().contentEquals(bytes)) dst.writeBytes(bytes)
+        }.onFailure { Timber.tag("DsrLauncher").w(it, "Agent install failed") }
+    }
+
+    /**
+     * Android kills the game instead of using Quit Game, so the game shows "Last time, the game may not have
+     * been closed using Quit Game..." on every start. The flag is byte 0x1068 of the save's system-data entry
+     * (BND4 entry 10: MD5(16) + IV(16) + AES-128-CBC). Clear it before launch (tools/sl2.py, docs/PORTING_LOG.md).
+     */
+    fun clearQuitFlag(context: Context) {
+        if (gameRunning()) return
+        val root = File(context.filesDir, "imagefs_shared/home/xuser-SHARED_PREFIX/.wine/drive_c/users/xuser/Documents/NBGI/DARK SOULS REMASTERED")
+        root.listFiles()?.map { File(it, "DRAKS0005.sl2") }?.filter { it.isFile }?.forEach { file ->
+            runCatching {
+                val buf = file.readBytes()
+                val n = ByteBuffer.wrap(buf).order(ByteOrder.LITTLE_ENDIAN)
+                val hdr = n.getLong(0x20).toInt()
+                val e = 0x40 + SYSTEM_ENTRY * hdr
+                val size = n.getLong(e + 8).toInt()
+                val off = n.getInt(e + 0x10)
+                val key = SecretKeySpec(SAVE_KEY, "AES")
+                val iv = IvParameterSpec(buf, off + 16, 16)
+                val plain = Cipher.getInstance("AES/CBC/NoPadding").apply { init(Cipher.DECRYPT_MODE, key, iv) }
+                    .doFinal(buf, off + 32, size - 32)
+                if (plain[QUIT_FLAG].toInt() == 0) return@runCatching
+                plain[QUIT_FLAG] = 0
+                val ct = Cipher.getInstance("AES/CBC/NoPadding").apply { init(Cipher.ENCRYPT_MODE, key, iv) }.doFinal(plain)
+                System.arraycopy(ct, 0, buf, off + 32, ct.size)
+                val md5 = MessageDigest.getInstance("MD5").apply { update(buf, off + 16, size - 16) }.digest()
+                System.arraycopy(md5, 0, buf, off, 16)
+                val tmp = File(file.path + ".tmp")
+                tmp.writeBytes(buf)
+                if (!tmp.renameTo(file)) error("rename failed")
+                Timber.tag("DsrLauncher").i("Cleared quit flag in %s", file.path)
+            }.onFailure { Timber.tag("DsrLauncher").w(it, "Quit flag clear failed: ${file.path}") }
+        }
+    }
+
+    private fun gameRunning(): Boolean = File("/proc").listFiles()?.any { p ->
+        p.name.toIntOrNull() != null && runCatching { File(p, "cmdline").readText().contains("DarkSoulsRemastered.exe") }.getOrDefault(false)
+    } ?: false
+
+    private const val SYSTEM_ENTRY = 10
+    private const val QUIT_FLAG = 0x1068
+    private val SAVE_KEY = byteArrayOf(0x01, 0x23, 0x45, 0x67, 0x89.toByte(), 0xAB.toByte(), 0xCD.toByte(), 0xEF.toByte(),
+        0xFE.toByte(), 0xDC.toByte(), 0xBA.toByte(), 0x98.toByte(), 0x76, 0x54, 0x32, 0x10)
+
+    /**
+     * Native phone aspect, no black bars (docs/ui/ASPECT_RATIO.md): DSR renders Hor+ and anchors its HUD itself, so the
+     * X screen / Wine desktop just takes the display's ratio, at RENDER_BUDGET x 1280x720 pixels.
+     * The agent (mod/dinput8/display.c) pins the game to borderless at that size.
+     */
+    /**
+     * Render pixels as a multiple of 1280x720 (1.1 = 1584x648 on the Flip6, 1.2 = ~1664x680, 2.0 = ~2128x872).
+     * 2.0 ran the GPU at 85-100 % and the phone at ~70 °C (throttling -> frame drops). Target: GPU <= 50 % in play
+     * (user, 2026-10-15): 1.2 + post effects off (1.1 measured 34 % with them on).
+     */
+    private const val MIN_HEIGHT = 648
+    private const val RENDER_BUDGET = 1.2   // start value; DsrGpuGovernor adjusts it per session
+
+    fun fitScreen(activity: Activity) {
+        val m = android.util.DisplayMetrics()
+        @Suppress("DEPRECATION") activity.windowManager.defaultDisplay.getRealMetrics(m)
+        val aspect = maxOf(m.widthPixels, m.heightPixels).toDouble() / minOf(m.widthPixels, m.heightPixels)
+        if (aspect < 1.7) return   // 16:9 or squarer (cover screen, tablets): keep the stock size
+        // multiples of 8 near the pixel budget, with the closest ratio (fit mode would show bars for any mismatch)
+        val budget = DsrGpuGovernor.budget(activity, RENDER_BUDGET)   // GPU <= 50 % (DsrGpuGovernor)
+        val target = Math.sqrt(1280.0 * 720 * budget / aspect)
+        val h0 = (-6..6).map { (target / 8).roundToInt() * 8 + it * 8 }
+            .minByOrNull { Math.abs((it * aspect / 8).roundToInt() * 8 / it.toDouble() - aspect) }!!
+        val h = maxOf(h0, MIN_HEIGHT)   // the game crashes at boot below ~600 lines (1408x576 did)
+        val w = (h * aspect / 8).roundToInt() * 8
+        val size = "${w}x$h"
+        writeDisplayIni(activity, w, h)
+        val f = File(activity.filesDir, "imagefs_shared/home/xuser-SHARED_PREFIX/.container")
+        runCatching {
+            val json = JSONObject(f.readText())
+            if (json.optString("screenSize") == size) return
+            json.put("screenSize", size)
+            f.writeText(json.toString())
+            Timber.tag("DsrLauncher").i("Screen %s (display %dx%d)", size, m.widthPixels, m.heightPixels)
+        }.onFailure { Timber.tag("DsrLauncher").w(it, "Screen size update failed") }
+    }
+
+    /**
+     * The game reads its display mode from DarkSouls.ini at boot, before the agent can pin it. A size it does not
+     * accept (e.g. after a borderless 1584x648 run) makes it fall back to fullscreen 800x600 and rewrite the ini:
+     * the picture then fills only the top-left corner. Write borderless (WindowMode=2) at the screen size every start,
+     * and switch the GPU post effects off (the in-game PC settings can turn them back on until the next start).
+     */
+    private fun writeDisplayIni(context: Context, w: Int, h: Int) {
+        val f = File(context.filesDir, "imagefs_shared/home/xuser-SHARED_PREFIX/.wine/drive_c/users/xuser/AppData/Local/FromSoftware/NBGI/DarkSouls/DarkSouls.ini")
+        if (!f.isFile || gameRunning()) return
+        runCatching {
+            var section = ""
+            val lines = f.readLines().map { line ->
+                if (line.startsWith("[")) section = line.trim()
+                val key = line.substringBefore('=', "").trim()   // the game writes "Key =value"
+                val sized = section == "[DisplaySettingWindow]" || section == "[DisplaySettingFullScreen]"
+                when {
+                    section == "[DisplaySetting]" && key == "WindowMode" -> "WindowMode=2"
+                    sized && key == "Width" -> "Width=$w"
+                    sized && key == "Height" -> "Height=$h"
+                    // GPU post effects off (motion blur, AA, depth of field, SSAO): GPU heat, not looks, limits play time
+                    section == "[DisplaySettingFilter]" && key in POST_EFFECTS_OFF -> "$key=0"
+                    else -> line
+                }
+            }
+            val text = lines.joinToString("\r\n", postfix = "\r\n")
+            if (text == f.readText()) return
+            f.writeText(text)
+            Timber.tag("DsrLauncher").i("DarkSouls.ini display -> borderless %dx%d", w, h)
+        }.onFailure { Timber.tag("DsrLauncher").w(it, "DarkSouls.ini update failed") }
+    }
+
+    private val POST_EFFECTS_OFF = setOf("Blur", "Antialiasing", "DOF", "AmbientOcclusion")
+
+    /** Launch request for the imported game, or null when it is not installed yet. */
+    fun launchRequest(context: Context): IntentLaunchManager.LaunchRequest? {
+        val idFile = File(gameDir(context), ".gamenative")
+        val id = runCatching { JSONObject(idFile.readText()).getInt("appId") }
+            .onFailure { Timber.tag("DsrLauncher").w(it, "No game id at ${idFile.path}") }
+            .getOrNull() ?: return null
+        return IntentLaunchManager.LaunchRequest("${GameSource.CUSTOM_GAME.name}_$id")
+    }
+}
diff --git a/app/src/main/java/app/gamenative/dsr/DsrTouchControls.java b/app/src/main/java/app/gamenative/dsr/DsrTouchControls.java
new file mode 100644
index 00000000..976794a1
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dsr/DsrTouchControls.java
@@ -0,0 +1,1166 @@
+package app.gamenative.dsr;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.os.SystemClock;
+import android.util.SparseArray;
+import android.view.HapticFeedbackConstants;
+import android.view.MotionEvent;
+import com.winlator.inputcontrols.Binding;
+import com.winlator.inputcontrols.ControlElement;
+import com.winlator.inputcontrols.ControlsProfile;
+import com.winlator.inputcontrols.GamepadState;
+import com.winlator.math.Mathf;
+import com.winlator.widget.InputControlsView;
+import timber.log.Timber;
+
+/**
+ * Dark Souls gameplay touch layer: design/final_wanted_controls.html (rev 31), docs/CONTROLS.md.
+ *
+ * Positions and sizes come from the profile (assets/inputcontrols/profiles/controls-6.icp).
+ * Each element's role comes from its first binding:
+ * STICK = floating move stick (double-tap = sprint), R1 = Attack (tap = R1, swipe up = R2),
+ * L1 = Block (hold + slide up = L2 parry on release, like the strong attack), D-pad down = Estus slot (tap = next item,
+ * double-tap = X), A = Interact pill, anything else = plain button (slide-through).
+ * A touch on no control and outside the stick zone is the camera (drag) or lock-on (tap).
+ * This class draws the controls (Bone & Ash skin) and owns every gameplay touch.
+ */
+public final class DsrTouchControls {
+    // Rules from the design, in dp and ms
+    private static final long ATTACK_WINDOW_MS = 80;
+    private static final float STRONG_ARM_DP = 12f;
+    private static final float STRONG_FIRE_DP = 30f;
+    private static final float SWIPE_DP = 22f;
+    private static final long ESTUS_DOUBLE_TAP_MS = 250;
+    private static final float ESTUS_STEP_DP = 40f;
+    private static final long SPRINT_DOUBLE_TAP_MS = 300;
+    private static final long FREE_TAP_MS = 180;
+    private static final float FREE_TAP_DP = 8f;
+    /** Tap-to-lock: max distance between the finger and an enemy's lock point on screen. */
+    private static final float LOCK_TAP_DP = 48f;
+    private static final float MIN_HIT_DP = 48f;
+    /** Stick float zone, relative to the stick home: from the left edge to +256 dp, from -66 dp to the bottom. */
+    private static final float STICK_ZONE_RIGHT_DP = 256f;
+    private static final float STICK_ZONE_UP_DP = 66f;
+    /** Camera: finger travel per move event (dp) that gives a full right-stick deflection. */
+    // Touch look = finger speed -> right stick (docs/CONTROLS.md "Camera"): smoothed, past the game's dead zone,
+    // eased out when the finger stops. The agent (cam.c) also turns the camera 1.5x faster than stock.
+    private static final float CAMERA_FULL_DPS = 520f;    // finger speed (dp/s) for full stick
+    private static final float CAMERA_DEAD = 0.16f;       // game stick dead zone: smallest output that turns
+    private static final float CAMERA_SMOOTH_MS = 28f;    // velocity filter time constant
+    private static final float CAMERA_RELEASE_MS = 45f;   // ease-out after the finger stops
+    private static final long CAMERA_TICK_MS = 16;
+    private static final long PULSE_MS = 70;
+    /** Shortest press the game sees: > 2 frames at 30 FPS. A quick tap (adb, fast finger) was missed by Start. */
+    private static final long MIN_HOLD_MS = 80;
+    private static final float ALPHA_IDLE = 0.45f;
+    private static final float ALPHA_TOUCHED = 0.70f;
+    private static final long FADE_MS = 150;
+    /** Interact pill <-> slot row cross-fade. */
+    private static final long SWAP_MS = 250;
+
+    // Bone & Ash skin (copies the game HUD: smoke-dark glass, bone-white rims)
+    private static final int FILL = 0x1c1a17;
+    private static final int FILL_PRESSED = 0x4a463f;
+    private static final int RIM = 0xcdc6b6;
+    private static final int RIM_PRIMARY = 0xece6d8;
+    private static final int INK = 0xebe5d8;
+    private static final int KNOB = 0xe6e0d2;
+    private static final int BRONZE = 0x8a6b45;      // game HUD line frames
+    private static final int BRONZE_LIT = 0xd9b47a;
+    private static final int EMBER = 0xff8a2a;   // armed strong attack
+    private static final float THUMB_DP = 26f;   // holds the heavy / parry icon
+    private static final long EMBER_PULSE_MS = 700;
+
+    private enum Role { STICK, ATTACK, BLOCK, ESTUS, INTERACT, BUTTON, CAMERA }
+    private enum AttackState { PENDING, FIRED, STRONG }
+
+    private static final class Touch {
+        Role role;
+        ControlElement element;
+        float downX, downY, stepX, curX, curY;   // cur = latest finger position (strong-attack thumb marker)
+        long downTime;
+        AttackState attack;
+        boolean strongArmed, onAttack, swiped, sprint;
+        Runnable attackFire;
+    }
+
+    private final InputControlsView view;
+    private final float dp;
+    private final SparseArray<Touch> touches = new SparseArray<>();
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+
+    private float stickX = Float.NaN, stickY, knobX, knobY;
+    private long lastStickDown;
+    private int cameraPointer = -1;
+    private float cameraLastX, cameraLastY;
+    private Runnable estusSingleTap;
+    private float visibility;
+    private long lastDrawTime;
+
+    private float camVX, camVY;   // smoothed finger velocity, dp/s
+    private long camLastMove;
+    /** While the finger rests (no move events), decay the smoothed velocity so the camera eases to a stop. */
+    private final Runnable cameraIdle = new Runnable() {
+        @Override public void run() {
+            long idle = SystemClock.uptimeMillis() - camLastMove;
+            if (idle < CAMERA_TICK_MS) { view.postDelayed(this, CAMERA_TICK_MS); return; }
+            float k = (float) Math.exp(-CAMERA_TICK_MS / CAMERA_RELEASE_MS);
+            camVX *= k; camVY *= k;
+            applyCamera();
+            if (Math.abs(camVX) + Math.abs(camVY) > 5f) view.postDelayed(this, CAMERA_TICK_MS);
+            else { camVX = camVY = 0; setCamera(0, 0); }
+        }
+    };
+
+    private static float cameraCurve(float v) {
+        float m = Math.min(1f, Math.abs(v) / CAMERA_FULL_DPS);
+        if (m < 0.01f) return 0f;
+        return Math.signum(v) * (CAMERA_DEAD + (1 - CAMERA_DEAD) * (float) Math.pow(m, 0.8));
+    }
+
+    private void applyCamera() {
+        setCamera(cameraCurve(camVX), cameraCurve(camVY));
+    }
+
+    public DsrTouchControls(InputControlsView view) {
+        this.view = view;
+        this.dp = view.getResources().getDisplayMetrics().density;
+        paint.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        paint.setTextAlign(Paint.Align.CENTER);
+        DsrAssets.INSTANCE.init(view.getContext());
+    }
+
+    // ---------------- touch ----------------
+
+    public boolean onTouchEvent(MotionEvent e) {
+        ControlsProfile profile = view.getProfile();
+        if (profile == null) return false;
+        if (DsrGameState.INSTANCE.getCutscene()) { skipTouch(e); return true; }
+        int am = e.getActionMasked();
+        switch (am) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN: {
+                int i = e.getActionIndex();
+                down(profile, e.getPointerId(i), e.getX(i), e.getY(i), e.getEventTime());
+                break;
+            }
+            case MotionEvent.ACTION_MOVE:
+                for (int i = 0; i < e.getPointerCount(); i++) move(profile, e.getPointerId(i), e.getX(i), e.getY(i), e.getEventTime());
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP: {
+                int i = e.getActionIndex();
+                up(e.getPointerId(i), e.getX(i), e.getY(i), e.getEventTime(), false);
+                break;
+            }
+            case MotionEvent.ACTION_CANCEL:
+                for (int i = touches.size() - 1; i >= 0; i--) up(touches.keyAt(i), 0, 0, e.getEventTime(), true);
+                break;
+        }
+        view.invalidate();
+        return true;
+    }
+
+    private void down(ControlsProfile profile, int id, float x, float y, long time) {
+        Touch t = new Touch();
+        t.downX = t.stepX = x;
+        t.downY = t.curY = y;
+        t.curX = x;
+        t.downTime = time;
+        t.element = hit(profile, x, y);
+        ControlElement stick = find(profile, ControlElement.Type.STICK);
+        if (t.element != null) t.role = roleOf(t.element);
+        else if (stick != null && inStickZone(stick, x, y) && !stickActive()) t.role = Role.STICK;
+        else if (cameraPointer == -1) t.role = Role.CAMERA;
+        else return;   // a second free finger does nothing
+        touches.put(id, t);
+
+        switch (t.role) {
+            case STICK:
+                t.element = stick;
+                stickX = knobX = x;
+                stickY = knobY = y;
+                if (time - lastStickDown <= SPRINT_DOUBLE_TAP_MS) {   // double-tap + drag = sprint (B held)
+                    t.sprint = true;
+                    press(Binding.GAMEPAD_BUTTON_B, true);
+                }
+                lastStickDown = time;
+                break;
+            case ATTACK:
+                t.attack = AttackState.PENDING;
+                t.attackFire = () -> {
+                    if (t.attack == AttackState.PENDING) { t.attack = AttackState.FIRED; pulse(Binding.GAMEPAD_BUTTON_R1); }
+                };
+                view.postDelayed(t.attackFire, ATTACK_WINDOW_MS);
+                haptic();
+                break;
+            case BLOCK:
+                press(Binding.GAMEPAD_BUTTON_L1, true);
+                haptic();
+                break;
+            case ESTUS:
+                break;   // acts on swipe or on release
+            case INTERACT:
+            case BUTTON:
+                press(t.element.getBindingAt(0), true);
+                haptic();
+                break;
+            case CAMERA:
+                cameraPointer = id;
+                cameraLastX = x;
+                cameraLastY = y;
+                camVX = camVY = 0;
+                camLastMove = time;
+                break;
+        }
+    }
+
+    private void move(ControlsProfile profile, int id, float x, float y, long time) {
+        Touch t = touches.get(id);
+        if (t == null) return;
+        switch (t.role) {
+            case STICK: {
+                float r = t.element.getBoundingBox().width() * 0.5f;
+                float dx = x - stickX, dy = y - stickY;
+                float len = (float) Math.hypot(dx, dy);
+                if (len > r) { dx *= r / len; dy *= r / len; }
+                knobX = stickX + dx;
+                knobY = stickY + dy;
+                GamepadState s = profile.getGamepadState();
+                s.thumbLX = Mathf.clamp(dx / r, -1, 1);
+                s.thumbLY = Mathf.clamp(dy / r, -1, 1);
+                commit();
+                break;
+            }
+            case ATTACK: {
+                t.curX = x;
+                t.curY = y;
+                float rise = t.downY - y;
+                if (t.attack == AttackState.PENDING && rise >= STRONG_ARM_DP * dp) {
+                    t.attack = AttackState.STRONG;
+                    view.removeCallbacks(t.attackFire);
+                }
+                if (t.attack == AttackState.STRONG) {
+                    boolean armed = rise >= STRONG_FIRE_DP * dp;
+                    if (armed && !t.strongArmed) haptic();
+                    t.strongArmed = armed;
+                }
+                break;
+            }
+            case BLOCK: {
+                // parry = the heavy attack gesture on Block: slide up (still guarding), armed at STRONG_FIRE_DP
+                // (ember pulse), release = L2. The thumb circle + chevrons show the aim (user, 2026-10-15).
+                t.curX = x;
+                t.curY = y;
+                float rise = t.downY - y;
+                if (t.attack != AttackState.STRONG && rise >= STRONG_ARM_DP * dp) t.attack = AttackState.STRONG;
+                if (t.attack == AttackState.STRONG) {
+                    boolean armed = rise >= STRONG_FIRE_DP * dp;
+                    if (armed && !t.strongArmed) haptic();
+                    t.strongArmed = armed;
+                }
+                // slide onto Attack while blocking = guard attack (R1 with L1 held)
+                ControlElement over = hit(profile, x, y);
+                boolean onAttack = over != null && roleOf(over) == Role.ATTACK;
+                if (onAttack && !t.onAttack && t.attack != AttackState.STRONG) { pulse(Binding.GAMEPAD_BUTTON_R1); haptic(); }
+                t.onAttack = onAttack;
+                break;
+            }
+            case ESTUS: {
+                float dx = x - t.stepX;
+                float need = (t.swiped ? ESTUS_STEP_DP : SWIPE_DP) * dp;
+                while (Math.abs(dx) >= need) {
+                    t.swiped = true;
+                    estusStep(dx > 0 ? 1 : -1);
+                    t.stepX += Math.signum(dx) * need;
+                    dx = x - t.stepX;
+                    need = ESTUS_STEP_DP * dp;
+                }
+                break;
+            }
+            case BUTTON: {
+                // slide-through: a finger that slides onto another plain button presses it
+                ControlElement over = hit(profile, x, y);
+                if (over != null && over != t.element && roleOf(over) == Role.BUTTON) {
+                    press(t.element.getBindingAt(0), false);
+                    t.element = over;
+                    press(over.getBindingAt(0), true);
+                    haptic();
+                }
+                break;
+            }
+            case CAMERA: {
+                float dx = x - cameraLastX, dy = y - cameraLastY;
+                cameraLastX = x;
+                cameraLastY = y;
+                float dtMs = Math.max(4f, time - camLastMove);
+                camLastMove = time;
+                float a = 1f - (float) Math.exp(-dtMs / CAMERA_SMOOTH_MS);
+                camVX += a * (dx / dp / dtMs * 1000f - camVX);
+                camVY += a * (dy / dp / dtMs * 1000f - camVY);
+                applyCamera();
+                view.removeCallbacks(cameraIdle);
+                view.postDelayed(cameraIdle, CAMERA_TICK_MS);
+                break;
+            }
+            default:
+                break;
+        }
+    }
+
+    private void up(int id, float x, float y, long time, boolean cancel) {
+        Touch t = touches.get(id);
+        if (t == null) return;
+        touches.remove(id);
+        ControlsProfile profile = view.getProfile();
+        switch (t.role) {
+            case STICK:
+                stickX = Float.NaN;
+                if (profile != null) {
+                    GamepadState s = profile.getGamepadState();
+                    s.thumbLX = s.thumbLY = 0;
+                }
+                if (t.sprint) press(Binding.GAMEPAD_BUTTON_B, false);
+                commit();
+                break;
+            case ATTACK:
+                view.removeCallbacks(t.attackFire);
+                if (cancel) break;
+                if (t.attack == AttackState.PENDING) pulse(Binding.GAMEPAD_BUTTON_R1);   // lifted inside the window
+                else if (t.attack == AttackState.STRONG && t.strongArmed) pulse(Binding.GAMEPAD_BUTTON_R2);
+                break;
+            case BLOCK:
+                press(Binding.GAMEPAD_BUTTON_L1, false);
+                if (!cancel && t.attack == AttackState.STRONG && t.strongArmed) { pulse(Binding.GAMEPAD_BUTTON_L2); haptic(); }
+                break;
+            case ESTUS:
+                if (cancel || t.swiped) break;
+                if (estusSingleTap != null) {   // second tap inside 250 ms = use the item
+                    view.removeCallbacks(estusSingleTap);
+                    estusSingleTap = null;
+                    pulse(Binding.GAMEPAD_BUTTON_X);
+                } else {
+                    estusSingleTap = () -> { estusSingleTap = null; estusStep(1); };
+                    view.postDelayed(estusSingleTap, ESTUS_DOUBLE_TAP_MS);
+                }
+                haptic();
+                break;
+            case INTERACT:
+            case BUTTON:
+                press(t.element.getBindingAt(0), false);
+                break;
+            case CAMERA:
+                cameraPointer = -1;
+                view.removeCallbacks(cameraIdle);
+                view.postDelayed(cameraIdle, CAMERA_TICK_MS);   // ease out instead of a hard stop
+                boolean tap = time - t.downTime < FREE_TAP_MS && Math.hypot(x - t.downX, y - t.downY) < FREE_TAP_DP * dp;
+                // NPC conversation: a free tap = A (next line / pick the highlighted answer), not a lock-on
+                if (tap && !cancel) { if (DsrGameState.INSTANCE.getTalking()) pulse(Binding.GAMEPAD_BUTTON_A); else lockOn(x, y); }
+                break;
+        }
+    }
+
+    /** +1 = next quick item (d-pad down), -1 = previous. */
+    private void estusStep(int dir) {
+        // The game has only "next item": previous = next (filled quick slots - 1) times, one press per 120 ms
+        int presses = dir > 0 ? 1 : DsrGameState.INSTANCE.getQuickSlots() - 1;
+        for (int i = 0; i < presses; i++) view.postDelayed(() -> pulse(Binding.GAMEPAD_DPAD_DOWN), i * 120L);
+        haptic();
+    }
+
+    /**
+     * Tap on a free area. Design: lock onto the enemy nearest the tap (within 40 dp), tap again = release.
+     * TODO(DLL): needs enemy screen positions from the agent and a way to set the lock target
+     * (the app can't write game memory). For now R3 toggles lock-on; the game picks the target.
+     */
+    /**
+     * Tap-to-lock (docs/LOCKON.md): project the game's lock candidates with its camera, take the one within
+     * LOCK_TAP_DP of the finger and ask the agent to lock it (tap the locked one or empty space = unlock).
+     * Nothing near and not locked = R3: the game picks, like before.
+     */
+    private void lockOn(float x, float y) {
+        DsrGameState.LockScan s = DsrGameState.INSTANCE.getLockScan();
+        float[] g = view.dsrToScreenFraction(x, y);
+        float[] g2 = view.dsrToScreenFraction(x + LOCK_TAP_DP * dp, y);
+        if (s == null || g == null || g2 == null) { pulse(Binding.GAMEPAD_BUTTON_R3); return; }
+        float tol = Math.abs(g2[0] - g[0]) * s.getW();
+        DsrGameState.LockCandidate c = DsrGameState.INSTANCE.pickLockTarget(g[0] * s.getW(), g[1] * s.getH(), tol);
+        if (c != null && !(s.getLocked() && (c.getFlags() & 0x20) != 0)) {
+            sendLock(String.format(java.util.Locale.ROOT, "lock %x %x", c.getLockPoint(), c.getHandle()));
+        } else if (s.getLocked()) {
+            sendLock("unlock");
+        } else {
+            pulse(Binding.GAMEPAD_BUTTON_R3);
+        }
+        haptic();
+    }
+
+    private long lockSeq;
+
+    /** Request file for the agent (mod/dinput8/lock.c): temp file + rename, so it never reads half a line. */
+    private void sendLock(String cmd) {
+        java.io.File dir = DsrLauncher.INSTANCE.gameDir(view.getContext());
+        java.io.File tmp = new java.io.File(dir, "dsr_lock.tmp");
+        try (java.io.FileWriter w = new java.io.FileWriter(tmp)) {
+            w.write(++lockSeq + " " + cmd + "\n");
+        } catch (java.io.IOException e) {
+            Timber.tag("DSR").w(e, "lock request failed");
+            return;
+        }
+        if (!tmp.renameTo(new java.io.File(dir, "dsr_lock.txt"))) Timber.tag("DSR").w("lock request rename failed");
+        Timber.tag("DSR").i("lock request: %s", cmd);
+    }
+
+    /** Releases everything this layer holds (phase change, cancel). */
+    public void reset() {
+        for (int i = 0; i < touches.size(); i++) {
+            Touch t = touches.valueAt(i);
+            if (t.attackFire != null) view.removeCallbacks(t.attackFire);
+        }
+        touches.clear();
+        if (estusSingleTap != null) view.removeCallbacks(estusSingleTap);
+        estusSingleTap = null;
+        view.removeCallbacks(cameraIdle);
+        camVX = camVY = 0;
+        cameraPointer = -1;
+        stickX = Float.NaN;
+    }
+
+    // ---------------- helpers ----------------
+
+    private static Role roleOf(ControlElement el) {
+        if (el.getType() == ControlElement.Type.STICK) return Role.STICK;
+        switch (el.getBindingAt(0)) {
+            case GAMEPAD_BUTTON_R1: return Role.ATTACK;
+            case GAMEPAD_BUTTON_L1: return Role.BLOCK;
+            case GAMEPAD_DPAD_DOWN: return Role.ESTUS;
+            case GAMEPAD_BUTTON_A: return Role.INTERACT;
+            default: return Role.BUTTON;
+        }
+    }
+
+    private static ControlElement find(ControlsProfile profile, ControlElement.Type type) {
+        for (ControlElement el : profile.getElements()) if (el.getType() == type) return el;
+        return null;
+    }
+
+    /** Nearest button whose hit area (never below 48 dp) contains the point. Sticks are not buttons. */
+    private ControlElement hit(ControlsProfile profile, float x, float y) {
+        ControlElement best = null;
+        float bestDist = Float.MAX_VALUE;
+        float minHalf = MIN_HIT_DP * dp * 0.5f;
+        for (ControlElement el : profile.getElements()) {
+            if (el.getType() != ControlElement.Type.BUTTON || hidden(el)) continue;
+            Rect b = el.getBoundingBox();
+            float hw = Math.max(b.width() * 0.5f, minHalf), hh = Math.max(b.height() * 0.5f, minHalf);
+            if (roleOf(el) == Role.INTERACT && !pillRect.isEmpty()) hw = Math.max(hw, pillRect.width() * 0.5f);
+            float dx = x - el.getX(), dy = y - el.getY();
+            boolean inside = el.getShape() == ControlElement.Shape.CIRCLE
+                    ? dx * dx + dy * dy <= hw * hw
+                    : Math.abs(dx) <= hw && Math.abs(dy) <= hh;
+            float d = dx * dx + dy * dy;
+            if (inside && d < bestDist) { best = el; bestDist = d; }
+        }
+        return best;
+    }
+
+    private boolean inStickZone(ControlElement stick, float x, float y) {
+        return x <= stick.getX() + STICK_ZONE_RIGHT_DP * dp && y >= stick.getY() - STICK_ZONE_UP_DP * dp;
+    }
+
+    private boolean stickActive() {
+        for (int i = 0; i < touches.size(); i++) if (touches.valueAt(i).role == Role.STICK) return true;
+        return false;
+    }
+
+    /** Press start per binding: a release is held back until the press lasted MIN_HOLD_MS (the game polls once a frame). */
+    private final java.util.EnumMap<Binding, Long> pressedAt = new java.util.EnumMap<>(Binding.class);
+
+    private void press(Binding b, boolean down) {
+        long now = SystemClock.uptimeMillis();
+        if (down) {
+            pressedAt.put(b, now);
+        } else {
+            Long at = pressedAt.get(b);
+            if (at != null && now - at < MIN_HOLD_MS) {
+                view.postDelayed(() -> { if (at.equals(pressedAt.get(b))) press(b, false); }, MIN_HOLD_MS - (now - at));
+                return;
+            }
+            pressedAt.remove(b);
+        }
+        view.handleInputEvent(b, down);
+        commit();
+    }
+
+    private void pulse(Binding b) {
+        press(b, true);
+        view.postDelayed(() -> press(b, false), PULSE_MS);
+    }
+
+    private void setCamera(float x, float y) {
+        ControlsProfile profile = view.getProfile();
+        if (profile == null) return;
+        GamepadState s = profile.getGamepadState();
+        s.thumbRX = x;
+        s.thumbRY = y;
+        commit();
+    }
+
+    private void commit() {
+        view.dsrCommitGamepad();
+    }
+
+    private void haptic() {
+        view.performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+    }
+
+    // ---------------- drawing ----------------
+
+    /** Draws the layer; fades in/out in 150 ms when gameplay starts/ends. */
+    public void draw(Canvas canvas, boolean gameplay) {
+        ControlsProfile profile = view.getProfile();
+        if (profile == null) return;
+        long now = SystemClock.uptimeMillis();
+        float step = lastDrawTime == 0 ? 16f / FADE_MS : Math.min(1, (now - lastDrawTime) / (float) FADE_MS);
+        lastDrawTime = now;
+        visibility = gameplay ? Math.min(1, visibility + step) : Math.max(0, visibility - step);
+        if (visibility > 0 && visibility < 1) view.postInvalidateOnAnimation();
+        if (visibility <= 0) { lastDrawTime = 0; return; }
+
+        float a = visibility * ALPHA_IDLE, held = visibility * ALPHA_TOUCHED;   // only the pressed control brightens
+        if (DsrGameState.INSTANCE.getCutscene()) { drawSkip(canvas); return; }
+        skipDone = false;
+        boolean prompt = promptUp();
+        float pStep = Math.min(1, step * FADE_MS / SWAP_MS);
+        promptMix = prompt ? Math.min(1, promptMix + pStep) : Math.max(0, promptMix - pStep);
+        if (promptMix > 0 && promptMix < 1) view.postInvalidateOnAnimation();
+        for (ControlElement el : profile.getElements()) {
+            Role role = roleOf(el);
+            float ea = role == Role.STICK ? (Float.isNaN(stickX) ? a : held) : isHeld(el) ? held : a;
+            if (role == Role.STICK) drawStick(canvas, el, ea);
+            else if (role == Role.INTERACT) { if (promptMix > 0) drawButton(canvas, el, role, ea * promptMix); }
+            else if (isRowSlot(el)) { if (promptMix < 1) drawButton(canvas, el, role, ea * (1 - promptMix) * (offHand(el) ? 0.4f : 1f)); }
+            else drawButton(canvas, el, role, ea);
+        }
+    }
+
+    /** Roll button label: B with the stick pushed rolls, with the stick idle it backsteps. */
+    private boolean stickPushed() {
+        if (Float.isNaN(stickX)) return false;
+        ControlsProfile profile = view.getProfile();
+        if (profile == null) return false;
+        for (ControlElement el : profile.getElements()) if (roleOf(el) == Role.STICK)
+            return Math.hypot(knobX - stickX, knobY - stickY) > el.getBoundingBox().width() * 0.5f * 0.2f;
+        return false;
+    }
+
+    /** Drawn pill bounds (it widens with the text); the hit test uses them. */
+    private final RectF pillRect = new RectF();
+
+    /** The game's own prompt text (tools/extract_assets.py prompts.json); "OK" for the item-get popup. */
+    private static String interactLabel(ControlElement el) {
+        int id = DsrGameState.INSTANCE.getActionPrompt();
+        if (id == 1) return "OK";
+        if (id == DsrGameState.TALK_PROMPT) return "Next";
+        String s = DsrAssets.INSTANCE.prompt(id);
+        return s != null ? s : el.getText();
+    }
+
+    /** Interact pill and the L-hand · spell · R-hand row share the bottom centre: the pill only while a prompt is up. */
+    private float promptMix;
+
+    private static boolean promptUp() {
+        return DsrGameState.INSTANCE.getActionPrompt() > 0;
+    }
+
+    private static boolean isRowSlot(ControlElement el) {
+        switch (el.getBindingAt(0)) {
+            case GAMEPAD_DPAD_LEFT: case GAMEPAD_DPAD_UP: case GAMEPAD_DPAD_RIGHT: return true;
+            default: return false;
+        }
+    }
+
+    /** While two-handing, the slot of the hand that is not used (the weapon on the back) is dimmed. */
+    private static boolean offHand(ControlElement el) {
+        DsrGameState.Loadout lo = DsrGameState.INSTANCE.getLoadout();
+        if (lo == null) return false;
+        Binding b = el.getBindingAt(0);
+        return lo.getStyle() == 3 && b == Binding.GAMEPAD_DPAD_LEFT || lo.getStyle() == 2 && b == Binding.GAMEPAD_DPAD_RIGHT;
+    }
+
+    private static boolean hidden(ControlElement el) {
+        return roleOf(el) == Role.INTERACT ? !promptUp() : isRowSlot(el) && promptUp();
+    }
+
+    private boolean isHeld(ControlElement el) {
+        for (int i = 0; i < touches.size(); i++) if (touches.valueAt(i).element == el) return true;
+        return false;
+    }
+
+    private Touch roleTouch(Role role) {
+        for (int i = 0; i < touches.size(); i++) if (touches.valueAt(i).role == role) return touches.valueAt(i);
+        return null;
+    }
+
+    private void drawButton(Canvas c, ControlElement el, Role role, float a) {
+        Rect b = el.getBoundingBox();
+        float cx = el.getX(), cy = el.getY();
+        boolean held = isHeld(el);
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(argb(held ? FILL_PRESSED : FILL, a * 1.25f));
+        float corner;
+        if (el.getShape() == ControlElement.Shape.CIRCLE) {
+            corner = -1;
+            c.drawCircle(cx, cy, b.width() * 0.5f, paint);
+        } else {
+            corner = role == Role.INTERACT ? b.height() * 0.5f : el.getShape() == ControlElement.Shape.SQUARE ? 7 * dp : 10 * dp;
+            rect.set(b);
+            if (role == Role.INTERACT) {   // the pill grows to fit the game's prompt text
+                paint.setTextSize(b.height() * 0.34f);
+                float w = Math.max(b.width(), paint.measureText(interactLabel(el)) + b.height());
+                rect.set(cx - w * 0.5f, b.top, cx + w * 0.5f, b.bottom);
+                pillRect.set(rect);
+            }
+            c.drawRoundRect(rect, corner, corner, paint);
+        }
+        boolean skinned = drawSkin(c, el, role, corner, held, a);
