+        android.graphics.Bitmap frame = app.gamenative.dsr.DsrAssets.INSTANCE.ui("lineframe");
+        float dens = getResources().getDisplayMetrics().density;
+        for (int i = 0; i < 4; i++) {
+            android.graphics.RectF r = dsrTab(i);
+            dsrMenuPaint.setStyle(android.graphics.Paint.Style.FILL);
+            dsrMenuPaint.setColor(0xcc1c1a17);
+            canvas.drawRect(r, dsrMenuPaint);
+            if (bg != null) canvas.drawBitmap(bg, null, r, null);
+            android.graphics.Bitmap icon = app.gamenative.dsr.DsrAssets.INSTANCE.ui("tab" + i + (i == active ? "_lit" : ""));
+            if (icon != null) {
+                android.graphics.RectF ir = new android.graphics.RectF(r);
+                ir.inset(r.width() * 0.08f, r.height() * 0.08f);
+                canvas.drawBitmap(icon, null, ir, null);
+            }
+            if (frame != null) canvas.drawBitmap(frame, null, r, null);
+            else {
+                dsrMenuPaint.setStyle(android.graphics.Paint.Style.STROKE);
+                dsrMenuPaint.setStrokeWidth(2 * dens);
+                dsrMenuPaint.setColor(i == active ? 0xffd9b47a : 0xff8a6b45);
+                canvas.drawRect(r, dsrMenuPaint);
+            }
+        }
+    }
+
+
+    private void dsrDrawMenuButtons(Canvas canvas) {
+        dsrDrawTabs(canvas);
+        float dens = getResources().getDisplayMetrics().density, corner = 10 * dens;
+        for (int i = 0; i < dsrMenuActionCount(); i++) {
+            android.graphics.RectF r = dsrMenuAction(i);
+            Binding act = dsrMenuActions()[i];
+            boolean held = dsrMenuHeldButton == act;
+            // the gameplay buttons' look: translucent fill + bronze rim, no dark parchment (user 2026-10-15)
+            dsrMenuPaint.setStyle(android.graphics.Paint.Style.FILL);
+            dsrMenuPaint.setColor(held ? 0x994a463f : 0x591c1a17);
+            canvas.drawRoundRect(r, corner, corner, dsrMenuPaint);
+            dsrMenuPaint.setStyle(android.graphics.Paint.Style.STROKE);
+            dsrMenuPaint.setStrokeWidth(2 * dens);
+            dsrMenuPaint.setColor(held ? 0xffd9b47a : 0xff8a6b45);   // bronze rim, lit while held
+            canvas.drawRoundRect(r, corner, corner, dsrMenuPaint);
+            dsrMenuPaint.setStyle(android.graphics.Paint.Style.FILL);
+            dsrMenuPaint.setTextAlign(android.graphics.Paint.Align.CENTER);
+            dsrMenuPaint.setTypeface(android.graphics.Typeface.create(android.graphics.Typeface.SERIF, android.graphics.Typeface.BOLD));
+            String label = dsrMenuLabel(act);
+            dsrMenuPaint.setTextSize(r.height() * (i == 0 ? 0.34f : label.length() == 1 ? 0.4f : 0.28f));
+            dsrMenuPaint.setColor(0xffebe5d8);
+            canvas.drawText(dsrMenuLabel(act), r.centerX(), r.centerY() + r.height() * 0.11f, dsrMenuPaint);
+        }
+    }
