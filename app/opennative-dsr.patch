+    private void dsrMenuTouch(MotionEvent e) {
+        if (xServer == null) { touchpadView.onTouchEvent(e); return; }
+        int am = e.getActionMasked();
+        if (am == MotionEvent.ACTION_POINTER_DOWN || am == MotionEvent.ACTION_POINTER_UP) return;
+        float x = e.getX(), y = e.getY();
+        switch (am) {
+            case MotionEvent.ACTION_DOWN: {
+                int b = dsrMenuButtonAt(x, y);
+                if (b >= 0) {
+                    dsrMenuHeldButton = dsrMenuActions()[b];
+                    if (dsrMenuHeldButton == Binding.KEY_ENTER) dsrLevelUpAccept();
+                    else { handleInputEvent(dsrMenuHeldButton, true); dsrCommitGamepad(); }
+                    performHapticFeedback(android.view.HapticFeedbackConstants.VIRTUAL_KEY);
+                    invalidate();
+                    break;
+                }
+                // hover DSR_HOVER_DELAY_MS after touch-down if the finger has not moved, so the click can follow
+                // right at lift (the game needs the hover a frame before the press). Not at touch-down: the game
+                // snaps the selection to the hovered row, so a swipe started on an item first selected that item
+                // (user 2026-10-15). Event times and uptimeMillis share one clock.
+                dsrMenuDownX = dsrMenuStepX = x; dsrMenuDownY = dsrMenuStepY = y; dsrMenuSwiped = false; dsrMenuAxis = 0;
+                dsrHoverAt = -1;
+                if (dsrMenuVel != null) dsrMenuVel.recycle();
+                dsrMenuVel = android.view.VelocityTracker.obtain();
+                dsrMenuVel.addMovement(e);
+                removeCallbacks(dsrHoverRun);
+                dsrHoverPending = dsrMouseScreen() && dsrTabAt(x, y) < 0;
+                if (dsrHoverPending) postDelayed(dsrHoverRun, DSR_HOVER_DELAY_MS);
+                break;
+            }
+            case MotionEvent.ACTION_MOVE: {
+                if (dsrMenuHeldButton != null) break;
+                if (dsrMenuVel != null) dsrMenuVel.addMovement(e);
+                if (!dsrMenuSwiped && Math.hypot(x - dsrMenuDownX, y - dsrMenuDownY) > DSR_TAP_SLOP_PX * 2) {
+                    dsrMenuSwiped = true;
+                    // one axis per swipe: a vertical scroll that drifts sideways no longer steps left / right
+                    dsrMenuAxis = Math.abs(y - dsrMenuDownY) >= Math.abs(x - dsrMenuDownX) ? 1 : 2;
+                    removeCallbacks(dsrHoverRun);
+                    boolean hovered = !dsrHoverPending && dsrHoverAt >= 0;
+                    dsrHoverPending = false;
+                    if (hovered) dsrParkPointer();   // a slow start already hovered: park, so the steps are not undone
+                }
+                if (!dsrMenuSwiped) break;
+                if (dsrMenuAxis == 1) {
+                    // finger up = list moves up = select the next item down (like dragging a phone list)
+                    while (y - dsrMenuStepY <= -DSR_SWIPE_STEP_PX) { dsrMenuStepY -= DSR_SWIPE_STEP_PX; dsrPadTap(Binding.GAMEPAD_DPAD_DOWN); }
+                    while (y - dsrMenuStepY >= DSR_SWIPE_STEP_PX) { dsrMenuStepY += DSR_SWIPE_STEP_PX; dsrPadTap(Binding.GAMEPAD_DPAD_UP); }
+                } else {
+                    // title main menu: tools/patch_menu.py lays the list out as one row, but it still steps with up/down
+                    boolean row = dsrTitleRow();
+                    while (x - dsrMenuStepX <= -DSR_SWIPE_STEP_PX) { dsrMenuStepX -= DSR_SWIPE_STEP_PX; dsrPadTap(row ? Binding.GAMEPAD_DPAD_DOWN : Binding.GAMEPAD_DPAD_RIGHT); }
+                    while (x - dsrMenuStepX >= DSR_SWIPE_STEP_PX) { dsrMenuStepX += DSR_SWIPE_STEP_PX; dsrPadTap(row ? Binding.GAMEPAD_DPAD_UP : Binding.GAMEPAD_DPAD_LEFT); }
+                }
+                break;
+            }
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL: {
+                if (dsrMenuHeldButton != null) {
+                    // hold >= 80 ms: the game polls once a frame (33 ms), a quick tap was missed
+                    final Binding held = dsrMenuHeldButton;
+                    long wait = Math.max(0, 80 - (e.getEventTime() - e.getDownTime()));
+                    if (held != Binding.KEY_ENTER) postDelayed(() -> { handleInputEvent(held, false); dsrCommitGamepad(); }, wait);
+                    dsrMenuHeldButton = null; invalidate();
+                    break;
+                }
+                removeCallbacks(dsrHoverRun);
+                boolean hoverPending = dsrHoverPending;
+                dsrHoverPending = false;
+                if (dsrMenuSwiped && am == MotionEvent.ACTION_UP) dsrFling();
+                if (dsrMenuVel != null) { dsrMenuVel.recycle(); dsrMenuVel = null; }
+                // title main menu only: its sub-screens (System list, Options, Load Game ...) take mouse clicks below
+                if (!dsrMenuSwiped && am == MotionEvent.ACTION_UP && dsrTitleRow()) {
+                    // the title ignores the mouse: "TOUCH TO START" = any tap presses A; in the one-row main menu
+                    // (tools/patch_menu.py) a tap on an entry highlights it (agent title.c) and presses A
+                    boolean listShown = app.gamenative.dsr.DsrGameState.INSTANCE.titleListShown();
+                    timber.log.Timber.tag("DSR").i("title tap %.0f,%.0f list=%b entry=%d", x, y, listShown, dsrTitleEntryAt(x, y));
+                    // "TOUCH TO START": one A. The list then fades in for a few seconds and ignores input; an A sent
+                    // then is queued by the game and runs on the highlighted entry (Continue). So a tap on an entry
+                    // goes to the agent, which moves the highlight once the list takes input and acks; A follows the
+                    // ack (title.c). Taps elsewhere before the list is up are dropped for 4 s after the start A.
+                    long now = android.os.SystemClock.uptimeMillis();
+                    int k = dsrTitleEntryAt(x, y);
+                    // fading = the list is fading in after the start A. Past 4 s with no list the start A was lost (the
+                    // game drops input while it boots: 2026-10-16, two taps did nothing): the next tap sends A again
+                    boolean fading = now - dsrTitleStartAt > 1200 && now - dsrTitleStartAt < 4000;
+                    if (k >= 0 && (listShown || fading)) {
+                        app.gamenative.dsr.DsrGameState.INSTANCE.pickTitleEntry(k);
+                        dsrAwaitTitleAck(now);
+                    } else if (!listShown && now - dsrTitleStartAt > 4000) {
+                        dsrTitleStartAt = now;
+                        dsrPadTap(Binding.GAMEPAD_BUTTON_A);
+                    }
+                    break;
+                }
+                int tab = !dsrMenuSwiped && am == MotionEvent.ACTION_UP ? dsrTabAt(x, y) : -1;
+                if (tab >= 0) { dsrClickTab(tab); break; }
+                if (!dsrMenuSwiped && am == MotionEvent.ACTION_UP) {
+                    // press at lift, >= 60 ms after the touch-down hover (2 frames at 30 FPS: a 40 ms gap landed in
+                    // one frame when frames ran late, and the click missed); taps are usually longer, so no wait
+                    dsrPointerTo(x, y);
+                    long since = hoverPending || dsrHoverAt < 0 ? 0 : e.getEventTime() - dsrHoverAt;
+                    // (2026-10-17: 130 ms made single taps only highlight in the menus, user: double tap needed; back to 60)
+                    dsrClick(Pointer.Button.BUTTON_LEFT, Math.max(0, 60 - since));
+                    postDelayed(this::dsrParkPointer, 250);   // keep hover from overriding later d-pad steps
+                }
+                break;
+            }
+        }
+    }
+
+    /** Title main menu (one-row list; taps go to the agent's pick): TITLE phase with no sub-screen open. The title's
+     *  System list, Options, Load Game etc. (titleSubScreen) take mouse hover + click like the in-game menus. */
+    private boolean dsrTitleRow() {
+        app.gamenative.dsr.DsrGameState g = app.gamenative.dsr.DsrGameState.INSTANCE;
+        return g.getPhase() == app.gamenative.dsr.DsrGameState.Phase.TITLE && !g.getTitleSubScreen();
+    }
+
+    /** Screens that take mouse hover + click: the in-game menu and the title sub-screens. */
+    private boolean dsrMouseScreen() {
+        app.gamenative.dsr.DsrGameState g = app.gamenative.dsr.DsrGameState.INSTANCE;
+        return g.getPhase() == app.gamenative.dsr.DsrGameState.Phase.MENU
+                || g.getPhase() == app.gamenative.dsr.DsrGameState.Phase.TITLE && g.getTitleSubScreen();
+    }
+
+    /** Fast flick at lift: a few more steps along the swipe axis (1 + 1 per 900 px/s over 1500 px/s, max 5). */
+    private void dsrFling() {
+        if (dsrMenuVel == null || dsrMenuAxis == 0) return;
+        dsrMenuVel.computeCurrentVelocity(1000);
+        float v = dsrMenuAxis == 1 ? dsrMenuVel.getYVelocity() : dsrMenuVel.getXVelocity();
+        if (Math.abs(v) < 1500) return;
+        int extra = Math.min(5, 1 + (int) ((Math.abs(v) - 1500) / 900));
+        boolean row = dsrTitleRow();
+        Binding b = dsrMenuAxis == 1 ? (v < 0 ? Binding.GAMEPAD_DPAD_DOWN : Binding.GAMEPAD_DPAD_UP)
+                : (v < 0 ? (row ? Binding.GAMEPAD_DPAD_DOWN : Binding.GAMEPAD_DPAD_RIGHT)
+                         : (row ? Binding.GAMEPAD_DPAD_UP : Binding.GAMEPAD_DPAD_LEFT));
+        for (int i = 0; i < extra; i++) dsrPadTap(b);
+    }
+
+    /** Main-menu entry under a tap, or -1. Same geometry as tools/patch_menu.py: 1280x720 design space centred,
+     *  scaled by height; entries centred at MENU_SLOTS, 300 wide, at y MENU_Y..MENU_Y+MENU_H (with some slack). */
+    private static final int[] DSR_TITLE_SLOTS = {-60, 290, 640, 990, 1340};
+    private static final float DSR_TITLE_Y = 520, DSR_TITLE_H = 72, DSR_TITLE_HALF_W = 150;
+    private long dsrTitleStartAt = -10000;
+
+    /** Press A once the agent acks the title pick (polls 50 ms, gives up after 7 s). */
+    private void dsrAwaitTitleAck(long since) {
+        if (app.gamenative.dsr.DsrGameState.INSTANCE.titleAcked()) { dsrPadTap(Binding.GAMEPAD_BUTTON_A); return; }
+        if (android.os.SystemClock.uptimeMillis() - since < 7000) postDelayed(() -> dsrAwaitTitleAck(since), 50);
+    }
+
+    private int dsrTitleEntryAt(float x, float y) {
+        float unit = getHeight() / 720f;
+        if (unit <= 0) return -1;
+        float dx = x / unit - (getWidth() / unit - 1280f) / 2f, dy = y / unit;
+        if (dy < DSR_TITLE_Y - 20 || dy > DSR_TITLE_Y + DSR_TITLE_H + 20) return -1;
+        for (int i = 0; i < DSR_TITLE_SLOTS.length; i++) if (Math.abs(dx - DSR_TITLE_SLOTS[i]) <= DSR_TITLE_HALF_W) return i;
+        return -1;
+    }
+
+    /** Queue d-pad taps 100 ms apart (70 ms press, one 30 FPS frame of gap) so fast swipes register one step each. */
+    private long dsrPadNextAt;
+    private void dsrPadTap(Binding b) {
+        long now = android.os.SystemClock.uptimeMillis();
+        long at = Math.max(now, dsrPadNextAt);
+        if (at - now > 300) return;   // backlog over 3 steps: dropped, so the list stops when the finger stops
+        dsrPadNextAt = at + 100;
+        postDelayed(() -> { handleInputEvent(b, true); dsrCommitGamepad(); }, at - now);
+        postDelayed(() -> { handleInputEvent(b, false); dsrCommitGamepad(); }, at - now + 70);
+    }
+
+    /** View point -> fraction (0..1) of the X screen (= the game's render frame), or null. Tap-to-lock projection. */
+    public float[] dsrToScreenFraction(float x, float y) {
+        if (touchpadView == null || xServer == null) return null;
+        float[] p = touchpadView.toXScreen(x, y);
+        return new float[] { p[0] / xServer.screenInfo.width, p[1] / xServer.screenInfo.height };
+    }
+
+    private void dsrPointerTo(float x, float y) {
+        float[] p = touchpadView.toXScreen(x, y);
+        xServer.injectPointerMove((int) p[0], (int) p[1]);
+    }
+
+    /** Pointer to the top-left corner of the game screen (no menu control there), so it hovers nothing. */
+    private void dsrParkPointer() {
+        if (xServer != null) xServer.injectPointerMove(0, 0);
+    }
+
+    private void dsrClick(Pointer.Button button, long delayMs) {
+        postDelayed(() -> {
+            if (xServer == null) return;
+            xServer.injectPointerButtonPress(button);
+            // >= 80 ms: the game samples the mouse once a frame (33 ms); 40 ms presses were sometimes missed
+            postDelayed(() -> { if (xServer != null) xServer.injectPointerButtonRelease(button); }, 80);
+        }, delayMs);
+    }
+
+    private void dsrReleaseAll() {
+        if (dsrControls != null) dsrControls.reset();
+        if (profile == null) return;
+        for (ControlElement element : profile.getElements()) for (int id = 0; id < 10; id++) element.handleTouchUp(id);
+        GamepadState state = profile.getGamepadState();
+        state.thumbLX = state.thumbLY = state.thumbRX = state.thumbRY = 0;
+        state.triggerL = state.triggerR = 0;
+        state.buttons = 0;
+        java.util.Arrays.fill(state.dpad, false);
+        dsrCommitGamepad();
+    }
+
+    public void dsrCommitGamepad() {
+        WinHandler winHandler = xServer != null ? xServer.getWinHandler() : null;
+        if (winHandler == null || profile == null) return;
+        GamepadState state = profile.getGamepadState();
+        ExternalController controller = winHandler.getCurrentController();
+        if (controller != null) controller.state.copy(state);
+        winHandler.sendGamepadState();
+        winHandler.sendVirtualGamepadState(state);
+    }
