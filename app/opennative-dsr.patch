+    /**
+     * Interact pill (rest at bonfire, read message, pick up ...): a very subtle pulse so it catches the eye
+     * (user 2026-10-15). A bronze outline grows out of the rim and fades every INTERACT_PULSE_MS; redraws at
+     * ~30 FPS only while the pill is up.
+     */
+    private static final long INTERACT_PULSE_MS = 1800;
+    private final RectF pulseRect = new RectF();
+    private void drawInteractPulse(Canvas c, float a) {
+        if (pillRect.isEmpty()) return;
+        float t = (SystemClock.uptimeMillis() % INTERACT_PULSE_MS) / (float) INTERACT_PULSE_MS;   // 0..1
+        float grow = 7 * dp * t;
+        pulseRect.set(pillRect);
+        pulseRect.inset(-grow, -grow);
+        float corner = pulseRect.height() * 0.5f;
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(1.6f * dp);
+        paint.setColor(argb(BRONZE_LIT, a * 0.55f * (1 - t) * (1 - t)));
+        c.drawRoundRect(pulseRect, corner, corner, paint);
+        view.postInvalidateDelayed(33);
+    }
